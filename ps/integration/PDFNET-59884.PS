/Group1SoftwareDict dup 100 dict def load begin
/EF /execform load def
/CM /currentmatrix load def
/CP /closepath load def
/FF /findfont load def
/FL /fill load def
/GR /grestore load def
/GS /gsave load def
/MV /moveto load def
/NP /newpath load def
/RL /rlineto load def
/LT /lineto load def
/EX /exch load def
/ROT /rotate load def
/RS /restore load def
/SCF /scalefont load def
/SCL /scale load def
/SCS /setcolorspace load def
/SF /setfont load def
/SG /setgray load def
/SH /show load def
/SLW /setlinewidth load def
/SM /setmatrix load def
/SP /showpage load def
/ST /stroke load def
/TR /translate load def
/SD /setdash load def
/PBB /pathbbox load def
/CRGB /currentrgbcolor load def
/SRGB /setrgbcolor load def
/SCMYK /setcmykcolor load def
/IE /ifelse load def
/SLJ /setlinejoin load def
/ENDP {
ST RS SP} def 
/STARTP /save load def
/line {
NP MV lineto CP} def 
/S_GR {
ST GR} def 
/GetDpi {
72 0 matrix defaultmatrix dtransform
/yres EX def /xres EX def
xres dup mul yres dup mul add sqrt dup 300 gt {pop 300} if } def 
/HVert {
 /h EX def /w EX def GS TR
0 3 w { 0 MV 0 h RL } for 0.6 SLW ST GR } def 
/HHorz {
 /h EX def /w EX def GS TR
0 3 h { 0 EX MV w 0 RL } for 0.6 SLW ST GR } def 
/HDiagUp {
 /h EX def /w EX def GS TR
0 4 h w add { w sub 0 EX MV w w RL }for 0.5 SLW ST GR } def 
/HDiagDown {
 /h EX def /w EX def GS TR
h w add -4 0 { 0 EX MV w w neg RL } for 0.5 SLW ST GR } def 
/PFill {
 GS clip
dup /t EX def 0 eq { FL } {
PBB CRGB 1 1 1 SRGB FL SRGB
/h EX def /w EX def /y EX def /x EX def
x y w x sub h y sub
t 0 eq {FL} if
t 1 eq {HHorz} if
t 2 eq {HVert} if
t 3 eq {HDiagUp} if
t 4 eq {HDiagDown} if
t 5 eq {4 copy HVert HHorz} if
t 6 eq {4 copy HDiagUp HDiagDown} if
} IE GR } def 
/ISOEncode
{ FF
dup length dict begin
{ 1 index /FID ne
{def} {pop pop} IE
} forall
/Encoding EX def
/FontName 1 index def
currentdict definefont pop
end
} bind def
/ellipsedict 8 dict def
ellipsedict /mtrx matrix put
/Ellipse {
 ellipsedict begin
/dir EX def
/endangle EX def /startangle EX def
/yrad EX def /xrad EX def
/y EX def /x EX def
/savematrix mtrx currentmatrix def
x y translate xrad yrad scale
dir 1 eq { 0 0 1 startangle endangle arcn}
{ 0 0 1 startangle endangle arc } IE
savematrix setmatrix end
} def 
/SymCircle {
/f EX def /r EX def /y EX def /x EX def
NP x y r r 0 360 0 Ellipse 1 SLW ST
f 1 eq {x y r r 0 360 0 Ellipse FL} if
} def 
/SymCircleLw {
/f EX def /lw EX def /r EX def /y EX def /x EX def
NP x y r r 0 360 0 Ellipse lw SLW ST
f 1 eq {x y r r 0 360 0 Ellipse FL} if
} def 
/SymBox {
/f EX def /r EX def r sub /y EX def r sub /x EX def
r 2 mul /w EX def NP x y MV 0 w RL w 0 RL 0 w neg RL CP 1 SLW ST
f 1 eq {NP x y MV 0 w RL w 0 RL 0 w neg RL CP FL}if
} def 
/SymBoxLw {
/f EX def /lw EX def /r EX def r sub /y EX def r sub /x EX def
r 2 mul /w EX def NP x y MV 0 w RL w 0 RL 0 w neg RL CP lw SLW ST
f 1 eq {NP x y MV 0 w RL w 0 RL 0 w neg RL CP FL}if
} def 
/SymDiamond {
/f EX def /r EX def /y EX def /x EX def
NP x r sub y MV r r neg RL r r RL r neg r RL CP 1 SLW ST
f 1 eq {NP x r sub y MV r r neg RL r r RL r neg r RL CP FL}if
} def 
/SymDiamondLw {
/f EX def /lw EX def /r EX def /y EX def /x EX def
NP x r sub y MV r r neg RL r r RL r neg r RL CP lw SLW ST
f 1 eq {NP x r sub y MV r r neg RL r r RL r neg r RL CP FL}if
} def 
/SymPlus {
/r EX def /y EX def /x EX def
r 2 mul /w EX def x r sub y MV w 0 RL x y r sub MV 0 w RL 1 SLW ST
} def 
/SymPlusLw {
/lw EX def /r EX def /y EX def /x EX def
r 2 mul /w EX def x r sub y MV w 0 RL x y r sub MV 0 w RL lw SLW ST
} def 
/SymX {
/r EX def /y EX def /x EX def r 2 mul /w EX def
x r sub y r sub MV w w RL x r add y r sub MV w neg w RL 1 SLW ST
} def 
/SymXLw {
/lw EX def /r EX def /y EX def /x EX def r 2 mul /w EX def
x r sub y r sub MV w w RL x r add y r sub MV w neg w RL lw SLW ST
} def 
/Sym5Star {
/dup /w EX def /r EX def /y EX def /x EX def
x y r SymX x y r sub MV 0 w RL 1 SLW ST
} def 
/Sym5StarLw {
/lw EX def /dup /w EX def /r EX def /y EX def /x EX def
x y r lw SymXLw x y r sub MV 0 w RL lw SLW ST
} def 
/Sym8Star {
/r EX def /y EX def /x EX def x y r SymX x y r SymPlus
} def 
/Sym8StarLw {
/lw EX def /r EX def /y EX def /x EX def x y r lw SymXLw x y r lw SymPlusLw
} def 
