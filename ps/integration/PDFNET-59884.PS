%%BeginProcSet: forms_ops 1.0 0
%%Title: (Forms Operators)
%%Version: 1.0
/forms_ops dup 10 dict def load begin
/G1StartEPSF {
userdict begin
/G1PreEPS_state save def
/G1dict_stack countdictstack def
/G1ops_count count 1 sub def
/showpage {} def 
0 setgray 0 setlinecap
1 setlinewidth 0 setlinejoin
10 setmiterlimit [ ] 0 setdash newpath
/languagelevel where
{pop languagelevel
1 ne
{false setstrokeadjust false setoverprint
} if
} if
} bind def
/G1EndEPSF {
count G1ops_count sub {pop} repeat
countdictstack G1dict_stack sub {end} repeat
G1PreEPS_state restore
end
} bind def 
