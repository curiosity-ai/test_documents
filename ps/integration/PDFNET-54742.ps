/filename (hfeibarchart.xml) def


/Run {

PostScript-Data-Initialize

Main

} bind def

/datarr {
  Data-Dictionary exch get
} bind def

/datarr:n{
  dup datarr :n
} bind def

/datarrval {
  4 dict begin
    /key exch def
    /ix exch def
    Data-Dictionary exch get /arr exch def
    arr length ix gt ix 0 ge and{
      arr ix get key get
    }{
      null
    }ifelse
  end
} bind def

/PostScript-Data-Initialize {

  % Errors / Data Overrides:

  /Series-Labels datarr{
    /data exch def
    data 3 get not{
      data 0 get length 0 eq{
        3 (Series Label Missing) () () data 5 get Error-Handler
      }{
        3 (Invalid Series Label) () data 0 get data 5 get Error-Handler
      }ifelse
    }if
  }forall

  /Series-Values datarr{
    /data exch def
    data 3 get not{
      data 0 get length 0 eq{
        3 (Series Data Missing) () () data 5 get Error-Handler
      }{
        data 0 get ([]) ne{
          3 (Invalid Series Data) () data 0 get data 5 get Error-Handler
        }if
      }ifelse
    }if
  }forall

  /ix 0 def
  /Series-Values-Override datarr{
    /data exch def
    data 3 get not{
      data 0 get length 0 eq{
        % No Override
      }{
        3 (Invalid Override Data) () data 0 get data 5 get Error-Handler
      }ifelse
    }if
    data 3 get{
      % here override
      data 2 get /value exch def
      data 4 get /caption exch def
      /Series-Values datarr ix get 2 value put
      /Series-Values datarr ix get 3 true put
      /Series-Values datarr ix get 4 caption put
    }if
    /ix ++
  }forall


  % Y-Axis Override:

	% /Parameters [ [ (PMS/295/100) (text) (color) ($A$2) ]
	% [ () () 0 false (ymin) ($B$2) ]
	% [ () () 0 false (ymax) ($C$2) ]
	% [ () () 0 false (yincrement) ($D$2) ] ]

  /anyvalid false def

  /Parameters datarr{
    /data exch def
    data length 4 gt{
      data 4 get /label exch def
      label (ymin) eq label (ymax) eq label (yincrement) eq or or{
        data 3 get{
          % update specdict with numeric values
          data 2 get /value exch def
          /S00-ValuesAxisOverride specdict label cvn value put
          /anyvalid true def
        }if
        % create local ymin, ymax, yincrement text variables
        data 0 get label cvn exch def
      }if
    }if
  }forall

  /S00-ValuesAxisOverride /ymin specdictvalue :notnull
  /S00-ValuesAxisOverride /ymax specdictvalue :notnull and{
  %/S00-ValuesAxisOverride /yincrement specdictvalue :notnull and and{
    /S00-ValuesAxisOverride specdict /override true put
  }if

  /S00-ValuesAxisOverride /override specdictvalue not{
    %ymin () ne ymax () ne yincrement () ne or or{
    ymin () ne ymax () ne  or{
      %one or more invalid / missing values

      /Parameters datarr{
        /data exch def
        data length 4 gt{
          data 4 get /label exch def
          data 5 get /location exch def
          %label (ymin) eq label (ymax) eq label (yincrement) eq or or{
          label (ymin) eq label (ymax) eq or{
            data 3 get not{
              label cvn cvx exec () eq{
                anyvalid{
                  % ignore blanks if none valid
                  3 (Missing Y-Axis Override Data) label label cvn cvx location Error-Handler
                }if
              }{
                3 (Invalid Y-Axis Override Data) label label cvn cvx location Error-Handler
              }ifelse
            }if
          }if
        }if
      }forall
    }if
  }if


  % Color Override:

% eg: /colortype (cmyk)    /color [46 77 0 30]      % purple
%	/Color [ [ (K/30) (color) (params) ($A$2) ]
%	[ (K) (K) 0 false (params) (0) ]
%	[ (30) (30) 30 true (params) (1) ] ]

% Bar gradient uses /S11-Bars
% _________________________________________________________________
/colorlength Data-Dictionary /BarColorSourceString get length def

  /colorvalid false def
  /colortype (empty) def
  colorlength 0 gt{
    /colorspec /BarColorSourceString datarr ToUpper def
	  /colorparts (/) colorspec StringSplit def
	  /colortype colorparts 0 get def
    colortype (K) eq colortype (PMS) eq or {
    	colortype (PMS) eq {
    	  /pantoneNumber  colorparts 1 get def
    	  pantoneNumber length 1 ge pantoneNumber length 4 le and {
    	  	pantoneNumber	:isNumericString {
            /colorvalid true def
          } if
        } if
      }{
      	colortype length 1 eq {
       	  /colorvalid true def
       	} if
      } ifelse
    }if
  }if

  colorvalid{
    % set default color
  
    Spec-Dictionary{
      /d exch def
      /n exch def
  
      d /default known{
        d /colortype colortype put
        d /color color put
        colortype (pms) eq{
          d /tint tint put
        }if
      }if
  
    }forall
  
  }{
    % invalid color
    %3 (Invalid Color Override Data) () colortype () Error-Handler
    %ColorOverrideRequired{
    %  /Color 0 3 datarrval /location exch def
    %  /Color 0 0 datarrval /colorstring exch def
    %  colorstring length 0 eq{
    %    3 (Color Override Data Missing) () colorstring location Error-Handler
    %  }{
    %    3 (Invalid Color Override Data) () colorstring location Error-Handler
    %  }ifelse
    %}if
  }ifelse


  % Pantone Colors:

  /Pantone-Color-Values datarr{
    /data exch def
    data length 4 eq{
      data 1 get /arr exch def
      arr length 6 eq{
        arr 0 get /id exch def
        arr 5 get /separation exch def
        [
          arr 1 get
          arr 2 get
          arr 3 get
          arr 4 get
        ] /tinttransform exch def

        Spec-Dictionary{
          /d exch def
          /n exch def
          d /colortype known d /color known and{
            n /colortype specdictvalue ToLower 0 get (p) 0 get eq n /color specdictvalue 0 get id eq and{
              d /separation separation put
              d /tinttransform tinttransform put
            }if
          }if
        }forall

      }if
    }if

  }forall


  % Font Dimensions:
  Spec-Dictionary{
    /d exch def
    /n exch def
    d FontMeasurements
  }forall
  
  SetColors_from_Parameters
} bind def

/SetColors_from_Parameters {
	% For gray:  BarColor length = 0
	/BarColor datarr length 1 eq {
    /BCA /BarColor datarr 0 get def % array
		/dictPantone <<
		  /colortype (pantone)
		  /color BCA 0 get
		  /tinttransform [BCA 1 get BCA 2 get BCA 3 get BCA 4 get ]
		  /separation BCA 5 get
    >> def
    % uncomment for pantone, comment-out for original (black usually)
    %dictPantone /S01-SeriesValuesLabels specdict Dict-AddTo pop
    %dictPantone /S05-HorizontalRule specdict Dict-AddTo pop
	} if
} def


Run


end

%%EOF
%%EndDocument
%Finished placing eps graphic
