/Measurements-Dictionary <<
	
>> def


/PostScript-Measurements{

  Measurements-Dictionary begin

    PostScript-Measurements-DataValidation

    PostScript-Measurements-Fixed

    PostScript-Measurements-Scale

    %PostScript-Measurements-Scale-Override

  end

} bind def
% END OF PostScript-Measurements ______________________________________________________
