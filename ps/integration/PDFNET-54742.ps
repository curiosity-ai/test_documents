% --------------------------------------------------------------------------
%                            Local lib
% --------------------------------------------------------------------------
% If in the C:\Program Files (x86)\gs\gs9.05\bin folder,
% this can be run as: (libForGSuse.ps) run

/:x { PageOriginX add } bind def

/:y { PageOriginY add } bind def

/MAX_STRING 8192 def

% ConcatX DEF % any any ConcatX string
% any (string or any cvs-friendly type <= MAX_STRING)
/ConcatX { %Concatenate two numbers or combination of strings and numbers
  4 dict begin
    /var2 exch def
    /var1 exch def
    { /str1 var1 dup type /stringtype ne{cvlit MAX_STRING string cvs}if def } stopped { /str1 (--ConcatX var1: value error or overflow--) def } if
    { /str2 var2 dup type /stringtype ne{cvlit MAX_STRING string cvs}if def } stopped { /str2 (--ConcatX var2: value error or overflow--) def } if
    /len1 str1 length def
    /strN str2 length len1 add string def
    strN 0 str1 putinterval
    strN len1 str2 putinterval
    strN
  end
} bind def
% END OF ConcatX ______________________________________________________

/ConcatToMark {
  2 dict begin
    /result () def
    counttomark /n exch def
    n 0 gt{
      counttomark 1 sub{
        ConcatX
      }repeat
      /result exch def
    }if
    cleartomark
    result
  end
} bind def
% END OF ConcatToMark ______________________________________________________

% ++ DEF % name ++ ()
/++{
  % usage: {/i ++} % increments integer i
  dup cvx exec 1 add def
} bind def
% END OF ++ ______________________________________________________

% -- DEF % name -- ()
/--{
  % usage: {/i --} % decrements integer i
  dup cvx exec 1 sub def
} bind def
% END OF -- ______________________________________________________

% += DEF % name string += string
% += DEF % name num += num
/+={
  % usage: {/s (suffix) +=} % appends suffix to string s
  % usage: {/i addend +=} % adds addend to number i
  exch % (suffix) /s
  dup cvx exec % (suffix) /s s
  3 -1 roll % /s s suffix
  dup type /stringtype eq{ConcatX}{add}ifelse
  def
} bind def
% END OF += ______________________________________________________

% -= DEF % name num -= num
/-={
  % usage: {/i sub -=} % subtracts sub from number i
  exch % (sub) /i
  dup cvx exec % (sub) /i i
  3 -1 roll % /i i sub
  sub
  def
} bind def
% END OF -= ______________________________________________________

% != DEF % name != ()
/!={
  % usage: {/b true def /b !=} => false
  % usage: {/b false def /b !=} => true
  dup cvx exec not
  def
} bind def
% END OF != ______________________________________________________

%                    Numeric methods
%________________________________________________________________
/nullzero{
  dup type /nulltype eq{pop 0}if
} bind def
% END OF nullzero ______________________________________________________

/nullstring{
  dup type /nulltype eq{pop ()}if
} bind def
% END OF nullstring ______________________________________________________

% bounds DEF % x lower upper -> bounds -> bool
% usage: true if x between lower and upper (inclusive)
/bounds {
  4 dict begin
    /upper exch def
    /lower exch def
    /x exch def
    x lower ge x upper le and
  end
} bind def
% END OF bounds ______________________________________________________

% CeilingX DEF % num1 num2 CeilingX num
% raise num1 to next ceiling by increment num2
/CeilingX{
  4 dict begin
    /interval exch def
    /value exch def
    /factor 1 interval div def
    /value value factor mul def  % multiply factor
    /value value ceiling def  % ceiling
    /value value factor div def  % divide factor
    value
  end
} bind def
% END OF CeilingX ______________________________________________________

% FloorX DEF % num1 num2 FloorX num
% lower num1 to next floor by increment num2
/FloorX{
  4 dict begin
    /interval exch def
    /value exch def
    /factor 1 interval div def
    /value value factor mul def  % multiply factor
    /value value floor def  % floor
    /value value factor div def  % divide factor
    value
  end
} bind def
% END OF FloorX ______________________________________________________

%                       String methods
%________________________________________________________________
% AsciiCharacterCode DEF % string AsciiCharacterCode int
/AsciiCharacterCode {
  0 get
} bind def
% END OF AsciiCharacterCode ______________________________________________________

% AsciiCharacter DEF % int AsciiCharacter string
/AsciiCharacter {
  2 dict begin
    /i exch def
    ( ) dup 0 i put
  end
} bind def
% END OF AsciiCharacter ______________________________________________________

% HexDigit DEF % num HexDigit hexdigit[0-9a-f]
/HexDigit{
  dup 10 15 bounds{
    87 add AsciiCharacter
  }if
  ToString
} bind def
% END OF HexDigit ______________________________________________________

% ToString DEF % any ToString string
/ToString {
  dup type /arraytype eq{
    () exch{
      dup type /integertype eq{AsciiCharacter}if
      ConcatX
    }forall
  }if
  () ConcatX
} bind def
% END OF ToString ______________________________________________________

% ToStringFloat1 DEF % number ToStringFloat1 string
% Formats number with 1 decimal place as a string
%    123 ToStringFloat1 -> (123.0)
%    123.456 ToStringFloat1 -> (123.5)
/ToStringFloat1 {
  10 mul round cvi 10 div ToString
} def
% END OF ToStringFloat1 ______________________________________________________

% ToStringArray DEF % string ToStringArray array
/ToStringArray {
  4 dict begin
    /source exch def
    /len source length def
    /result [len{( )}repeat] def
    0 1 len 1 sub{
      /i exch def
      /s ( ) def
      s 0 source i get put
      /a [s ToString] def
      result i a putinterval
    }for
    result
  end
} bind def
% END OF ToStringArray ______________________________________________________

% ToAsciiArray DEF % string ToAsciiArray array
/ToAsciiArray{
  4 dict begin
    /s exch def
    s length array /result exch def
    0 1 s length 1 sub{
      /ix exch def
      result ix s ix get put
    }for
    result
  end
} bind def
% END OF ToAsciiArray ______________________________________________________

% Dict-Copy DEF % dict1 dict_destination Dict-AddTo dict_destination_plus_dict1
% eg:
%  /dict_destination << /a 1 /b 2 >> def
%  /dict1            << /b 20 /c 3 >> def
%  dict1 dict_destination Dict-AddTo ===> << /a 1 /b 20 /c 3 >>
% 
/Dict-AddTo { copy } def
% END OF Dict-AddTo ______________________________________________________

% SpaceX DEF % int SpaceX (...[spaces]...)
/SpaceX {
  () exch
  { ( ) ConcatX }repeat
} bind def
% END OF SpaceX ______________________________________________________

% StringWidthX DEF string StringWidthX width
/StringWidthX{
  stringwidth pop
} bind def
% END OF StringWidthX ______________________________________________________

% String-Truncate DEF string String-Truncate str...
/String-Truncate{
  8 dict begin
  /len exch def
  /text exch def
  text ToStringArray /textarr exch def
  /result () def
  0 1 textarr :n{
    /ix exch def
    ix len lt{
      /result textarr ix get +=
    }if
  }for
  textarr length len gt{
    /result (...) +=
  }if
  result
  end
} bind def
% END OF String-Truncate ______________________________________________________

% ToLower DEF % string ToLower string
/ToLower {
  4 dict begin
    /target exch def
    /result target length string def
    0 1 target length 1 sub{
      /ix exch def
      /char target ix get def
      char 65 90 bounds{
        /char char 32 add def
      }if
      result ix char put
    }for
    result
  end
} bind def
% END OF ToLower ______________________________________________________

% ToUpper DEF % string ToUpper string
/ToUpper {
  4 dict begin
    /target exch def
    /result target length string def
    0 1 target length 1 sub{
      /ix exch def
      /char target ix get def
      char 97 122 bounds{
        /char char 32 sub def
      }if
      result ix char put
    }for
    result
  end
} bind def
% END OF ToUpper ______________________________________________________

% text search -> Contains -> bool
/Contains {
  4 dict begin
    /srch exch def
    /text exch def
    text ToLower srch ToLower search /result exch def
    pop result{pop pop}if
    result
  end
} bind def
% END OF Contains ______________________________________________________

% Octal DEF % decimal => Octal => octal
/Octal {
  6 dict begin
    /input exch def
    /octal () def
    /r input 64 mod def
    /m input r sub 64 div cvi def
    /input input m 64 mul sub def
    /octal m ToString +=
    /r input 8 mod def
    /m input r sub 8 div cvi def
    /input input m 8 mul sub def
    /octal m ToString +=
    /m input def
    /octal m ToString +=
    octal
  end
} bind def
% END OF Octal ______________________________________________________

% Hex DEF % decimal => Hex => hex
/Hex {
  6 dict begin
    /input exch def
    /hex () def
    4 -1 0{
      /e exch def
      /d 16 e exp cvi def
      /r input d mod def
      /m input r sub d div cvi def
      /input input m d mul sub def
      m 0 gt hex length 0 gt or{
        /hex m HexDigit +=
      }if
    }for
    hex
  end
} bind def
% END OF Hex ______________________________________________________

/:array   { dup type /arraytype eq   } bind def
/:boolean { dup type /booleantype eq } bind def
/:dict    { dup type /dicttype eq    } bind def
/:exec    { dup xcheck               } bind def
/:half    { 2 div                    } bind def
/:integer { dup type /integertype eq } bind def
/:length  { dup length               } bind def
/:mark    { dup type /marktype eq    } bind def
/:n       {     length 1 sub         } bind def
/:name    { dup type /nametype eq    } bind def
/:notnull {     type /nulltype ne    } bind def
/:nonzero { :zero not                } bind def
/:null    { dup type /nulltype eq    } bind def
/:read    { dup rcheck               } bind def
/:real    { dup type /realtype eq    } bind def
/:string  { dup type /stringtype eq  } bind def
/:type    { dup type 255 string cvs  } bind def
/:write   { dup wcheck               } bind def
/:zero    { dup 0 eq                 } bind def

% dict key -> :known -> dict false
% dict key -> :known -> dict value true
/:known {
  4 dict begin
    /key exch def     % name
    /d exch def       % dict
    /result d key known def
    result{
      /value d key get def
    }if
    d                 % leave dict on stack
    result{value}if   % leave value on stack if true
    result            % leave bool on stack
  end
} bind def
% END OF :known ______________________________________________________

/:first {
  :array{
    0 get
  }if
  :string{
    0 get AsciiCharacter
  }if
} bind def
% END OF :first ______________________________________________________

% character string startswith --> [true|false]
%    where character means a string of length 1
/startswith {
  :first eq
} bind def
% END OF startswith ______________________________________________________

/:last{
  :array{
    dup length 1 sub get
  }if
  :string{
    dup length 1 sub get AsciiCharacter
  }if
} bind def
% END OF :last ______________________________________________________

% character string endswith --> [true|false]
%    where character means a string of length 1
/endswith {
  :last eq
} bind def
% END OF endswith ______________________________________________________

/:00^ {
  0.01 CeilingX
} bind def

/:name:array {
  2 dict begin
    :name /b1 exch def
    :array /b2 exch def
    b1 b2 or
  end
} bind def
% END OF :name:array ______________________________________________________

/:array:string {
  2 dict begin
    :array /b1 exch def
    :string /b2 exch def
    b1 b2 or
  end
} bind def
% END OF :array:string ______________________________________________________

/:array:string:dict {
  4 dict begin
    :array /b1 exch def
    :string /b2 exch def
    :dict /b3 exch def
    b1 b2 b3 or or
  end
} bind def
% END OF :array:string:dict ______________________________________________________

/:error {
  Error-Dictionary /Current-Error-Condition get
} bind def
% END OF :error ______________________________________________________

/:noerror {
  :error not
} bind def
% END OF :noerror ______________________________________________________

/:places {
  4 dict begin
    /val exch def
    /result 0 def
    val val cvi ne{
      /s val ToString def
      0 1 s :n{
        /ix exch def
        s ix get (.) 0 get eq{
          /result 0 def
        }{
          /result ++
        }ifelse
      }for
    }if
    result
  end
} bind def
% END OF :places ______________________________________________________

% :min DEF % array [delegate] :min => min int (int is number, index, character code, or delegate)
% usage: [5 7 3 9 4 8 5] :min => 3
% usage: [(IDC) (Techops)(Test)] :min => (IDC Techops)
% usage: (Zebra) {} :min => 90 % Z = 90
% usage: [(IDC) (Techops)(Test)] {length} :min => 4
/:min {
  8 dict begin
    :name{
      cvx load
    }if
    :exec{
      /:min-delegate exch def
    }if
    currentdict /:min-delegate known not{
      /:min-delegate {} def
    }if
    /source exch def
    /min null def
    source{
      /item exch def
      item :min-delegate exec /current exch def
      min null eq{
        /min current def
      }if
      current null ne{
        current min lt{
          /min current def
        }if
      }if
    }forall
    min
  end
} bind def
% END OF :min ______________________________________________________

% :max DEF % array [delegate] :max => max int (int is number, index, character code, or delegate)
% usage: [5 7 3 9 4 8 5] :max => 9
% usage: [(Chuck)(Carmody)(Test)] :max => (Test)
% usage: (Zebra) {} :max => 114 % r = 114
% usage: [(Chuck)(Carmody)(Test)] {length} :max => 7
/:max {
  8 dict begin
    :name{
      cvx load
    }if
    :exec{
      /:max-delegate exch def
    }if
    currentdict /:max-delegate known not{
      /:max-delegate {} def
    }if
    /source exch def
    /max null def
    source{
      /item exch def
      item :max-delegate exec /current exch def
      max null eq{
        /max current def
      }if
      current null ne{
        current max gt{
          /max current def
        }if
      }if
    }forall
    max
  end
} bind def
% END OF :max ______________________________________________________

% ModX DEF % num1 num2 ModX num
% mod num1 by num2
/ModX{
  8 dict begin
    /num2 exch def
    /num1 exch def
    /power num1 :places def
    /p2 num2 :places def
    p2 power gt{/power p2 def}if
    /factor 10 power exp def
    /i1 num1 factor mul cvi def
    /i2 num2 factor mul cvi def
    /r i1 i2 mod def
    r factor div
  end
} bind def
% END OF ModX ______________________________________________________

% Array-Push DEF % array object Array-Push array
% Array-Push DEF % name object Array-Push -
/Array-Push {
    exch
    :name{
      dup cvx load % object name arr
      3 -1 roll % name arr object
        Array-Push
      def
    }{
      4 dict begin
        :string /:string? exch def
        :string?{ToStringArray}if
        /source exch def
        /object exch def
        /target source length 1 add array def
        target 0 source putinterval
        target target length 1 sub object put
        target
        :string?{ToString}if
      end
    }ifelse
} bind def
% END OF Array-Push ______________________________________________________

% Array-Pop DEF % array object Array-Pop array
% Array-Pop DEF % array Array-Pop array
% Array-Pop DEF % name object Array-Pop -
% Array-Pop DEF % name Array-Pop -
% string Array-Pop ambiguous : use: string null Array-Pop
/Array-Pop {
  :name:array{
    % default pop last item
    null Array-Pop
  }{
    exch
    :name{  % name second arg, expand + recurse
      dup cvx load % object name arr
      3 -1 roll % name arr object
        Array-Pop
      def
    }{
      8 dict begin
        :string /:string? exch def
        :string?{ToStringArray}if
        /source exch def
        /arr1 [] def
        :null{
          pop
          0 1 source length 2 sub{
            /i exch def
            /value source i get def
            /arr1 value Array-Push
          }for
        }{
          /object exch def
          /removed false def
          0 1 source :n{
            /i exch def
            /value source i get def
            value object ne removed or{
              /arr1 value Array-Push
            }{
              /removed true def
            }ifelse
          }for
        }ifelse
        arr1
        :string?{ToString}if
      end
    }ifelse
  }ifelse
} bind def
% END OF Array-Pop ______________________________________________________

% Array-Copy DEF % array Array-Copy newarray
% Array-Copy DEF % name Array-Copy -
/Array-Copy {
  :name{
    exch Array-Copy def
  }{
    :string /:string? exch def
    :string?{ToStringArray}if
    dup length array dup % array newarray newarray
    3 -1 roll % newarray newarray array
    0 exch putinterval
    :string?{ToString}if
  }ifelse
} bind def
% END OF Array-Copy ______________________________________________________

% Array-Split DEF % array index Array-Split => [] []
% Splits array before element index
/Array-Split {
  6 dict begin
    /splitindex exch def
    :name{cvx load}if
    :string /:string? exch def
    :string?{ToStringArray}if
    /source exch def
    /arr1 [] def
    /arr2 [] def
    0 1 splitindex 1 sub{
      /i exch def
      /arr1 source i get Array-Push
    }for
    splitindex 1 source length 1 sub{
      /i exch def
      /arr2 source i get Array-Push
    }for
    arr1
    :string?{ToString}if
    arr2
    :string?{ToString}if
  end
} bind def
% END OF Array-Split ______________________________________________________

% Array-Sort DEF % [] index Array-Sort => []
/Array-Sort {
  :name{
    dup cvx load
      Array-Sort
    def
  }{
    4 dict begin
      :string /:string? exch def
      :string?{ToStringArray}if
      /arr exch def
      /result [] def
      0 1 arr :n{
        /ix exch def
        arr :min /val exch def
        /result val Array-Push
        /arr val Array-Pop
      }for
      result
      :string?{ToString}if
    end
  }ifelse
} bind def
% END OF Array-Sort ______________________________________________________

% Array-Reverse DEF % array Array-Reverse array
% Array-Reverse DEF % name Array-Reverse -
/Array-Reverse {
    :name{
      dup cvx load
        Array-Reverse
      def
    }{
      4 dict begin
        :exec /:exec? exch def
        :string /:string? exch def
        :string?{ToStringArray}if
        cvlit /source exch def
        /target source length array def
        /maxindex source :n def
        0 1 maxindex{
          /ix exch def
          target maxindex ix sub source ix get put
        }for
        target
        :exec?{cvx}if
        :string?{ToString}if
      end
    }ifelse
} bind def
% END OF Array-Reverse ______________________________________________________

% text search replace String-Replace -> string
/String-Replace {
  16 dict begin
    /replace exch def
    /srch exch def
    /text exch def
    1 1 text length{
      /ix exch def
      text srch Contains{
        text ToLower srch ToLower search pop
        length /len1 exch def
        length /len2 exch def pop
        text len1 Array-Split
        /seg2 exch def
        /seg1 exch def
        mark
        seg1
        replace
        seg2 len2 Array-Split exch pop ConcatToMark
        /text exch def
      }{
        exit
      }ifelse
    }for
    text
  end
} bind def
% END OF Array-Replace ______________________________________________________

% any array Array-Contains ==> true oe false
% eg:  2 [1 2 3 4 5] Array-Contains ==> true
% eg: 10 [1 2 3 4 5] Array-Contains ==> false
/Array-Contains {
  exch
  10 dict begin
    /anyItem exch def
    /result false def
    {
      anyItem eq { /result true def exit } if
    } forall
    result
  end
} bind def
% END OF Array-Contains ______________________________________________________

% delimiter string StringSplit ==> array
% eg: (/) (06/30/2007) StringSplit ==> [(06) (30) (2007)]
/StringSplit {
  /s exch def
  /delim exch def
  [
    s
    {
      delim search
      {
        exch pop exch
      }{
        exit
      } ifelse
    } loop
  ]
} bind def
% END OF StringSplit ______________________________________________________

% index total steps -> Series-Spline -> newindex
% smoothes/converts index:steps -> newindex:total
/Series-Spline{
  8 dict begin
    /steps exch def               % visible steps/labels
    /total exch def               % total steps
    /ix exch def                  % current index - zero-based
    /inc total 1 sub steps 1 sub div def  % divide step increment
    /rawval ix inc mul def        % raw value
    /result rawval round cvi def  % new index - zero-based
    result
  end
} bind def
% END OF Series-Spline ______________________________________________________

/Format1000s{
  4 dict begin
    (.) exch StringSplit /aStringParts exch def
    /text aStringParts 0 get def
    /i 0 def
    /result () def
    text ToString Array-Reverse ToStringArray{
      /s exch def
      i 3 mod 0 eq i 0 gt and{/result (,) +=}if
      /result s +=
      /i ++
    }forall
    /result result Array-Reverse def
    aStringParts length 2 eq {
      /result (.) +=
      /result aStringParts 1 get +=
    } if
    result
  end
} bind def
% END OF Format1000s ______________________________________________________

/WHITESPACE [( )(\r\n\f\t\b)] def
/NEWLINES [(\r\n\f)] def
/LEFT_BRACE ({) def
/RIGHT_BRACE (}) def
/ASTERISK (*) def % sup
/CARET (^) def    % sup
/DAGGER (dagger) def % sup
/ONE_SUP (onesuperior) def % sup
/TWO_SUP (twosuperior) def % sup
/THREE_SUP (threesuperior) def % sup
/PIPE (|) def
/FWD_SLASH (/) def

/NO_SUP {
  2 dict begin
    /s exch def
    s ASTERISK eq
    s CARET eq or
    s ONE_SUP eq or
    s TWO_SUP eq or
    s THREE_SUP eq or
    % s DAGGER eq or
  end
} bind def
% END OF NO_SUP ______________________________________________________

/String-Split {
  WHITESPACE false String-Split-Internal
} bind def
% END OF String-Split ______________________________________________________

/String-Split-Internal {
  8 dict begin
    /preserve exch def
    /delimiters exch def
    /text exch def
    /result [] def
    /s ( ) def  % one-length string
    /t () def
    % convert string array param to character array
    /idelimiters [] def
    delimiters{
      {
        /idelimiters exch Array-Push
      }forall
    }forall
    % handle newline overrides first
    /escape false def
    text{
      /char exch def
      escape true eq{
        char (n) 0 get eq{
          /result t Array-Push
          /idelimiters [] def
          /t () def
        }{
          /t (\\) +=
          s 0 char put
          /t s +=
        }ifelse
        /escape false def
      }{
        char (\\) 0 get eq{
          /escape true def
        }{
          s 0 char put
          /t s +=
        }ifelse
      }ifelse
    }forall
    % add last string
    result length 0 gt t length 0 gt and{
      /result t Array-Push
      /t () def
    }if
    /t () def
    result length 0 eq{
      text{
        /i exch def
        /bdelim false def
        idelimiters{
          i eq{/bdelim true def}if
        }forall
        % treat consecutive delimiters as one when {//preserve false eq}
        bdelim{
          % new string
          preserve{
            %add to string
            s 0 i put
            /t s +=
          }if
          t length 0 gt{
            /result t Array-Push
          }if
          /t () def
        }{
          %add to string
          s 0 i put
          /t s +=
        }ifelse
      }forall
      % add last string
      t length 0 gt{
        /result t Array-Push
      }if
    }if
    result
  end
} bind def
% END OF String-Split-Internal ______________________________________________________

/String-Split-Newlines {
  NEWLINES false String-Split-Internal
} bind def
% END OF String-Split-Newlines ______________________________________________________

/specdict {
  Spec-Dictionary begin
    currentdict exch get
  end
} bind def
% END OF specdict ______________________________________________________

/specdictvalue {
  /key exch def
  Spec-Dictionary begin
    currentdict exch get key get
  end
} bind def
% END OF specdictvalue ______________________________________________________

% finds dict with matching key/value
% key value -> specdictkey -> dict
/specdictkey {
  8 dict begin
    /value exch def
    /key exch def     % name
    /target null def

      Spec-Dictionary{
        /d exch def
        /n exch def

        d key known{
          d key get value eq{/target d def}if
        }if

      }forall

    target

  end
} bind def
% END OF specdictkey ____________________________________________

% finds fontdict with matching fontindex
% fontindex -> specfontindex -> dict
/specdictfontindex{
  /fontindex exch specdictkey
} bind def
% END OF specdictfontindex ____________________________________________

% retrieves key value from fontdict with matching fontindex
% fontindex key -> specdictfontindexkey -> value
/specdictfontindexkey{
  /key exch def
  specdictfontindex :null not{key get}if
} bind def
% END OF specdictfontindexkey ____________________________________________

/:isNumericString {
  10 dict begin
    /strTmp exch def
    /nDots 0 def
    /r strTmp length 0 gt def
    /aTmp strTmp ToStringArray def
    0 1 aTmp :n {
      /ix exch def
      aTmp ix get /c exch def
      c (.) eq { /nDots ++ } if
      nDots 1 gt { /r false def exit } if                     % Only 1 dot allowed
      (+-) c Contains ix 0 ne and { /r false def exit } if    % + or - only as first character
      /r (0123456789.+-) c Contains def
      r not { exit } if
    } for
    strTmp
    r
  end
} bind def
% END OF :isNumericString ______________________________________________________

/:isDateString {
  10 dict begin
    /strLabelDate exch def
    /r true def
    strLabelDate :string {
      (/) exch StringSplit /aLabelDate exch def
      /aLabelDateLen aLabelDate length def
      aLabelDate { :isNumericString exch pop not {  /r false def } if } forall
      aLabelDateLen 2 eq {
        aLabelDate 0 get :isNumericString { /iMonth exch cvi def }{ pop /r false def } ifelse
        aLabelDate 1 get :isNumericString { /iYear  exch cvi def }{ pop /r false def } ifelse
        /iDay 1 def
      }{
        aLabelDateLen 3 eq {
          aLabelDate 0 get :isNumericString { /iMonth exch cvi def }{ pop /r false def } ifelse
          aLabelDate 1 get :isNumericString { /iDay   exch cvi def }{ pop /r false def } ifelse
          aLabelDate 2 get :isNumericString { /iYear  exch cvi def }{ pop /r false def } ifelse
        }{
            /r false def % not mm/yy or mm/dd/yy (yy can be yyyy also)
        } ifelse
      } ifelse
      % Test range of month day year
      r {
        iDay    1 lt { /r false def } if
        iDay   31 gt { /r false def } if
        iMonth  1 lt { /r false def } if
        iMonth 12 gt { /r false def } if
        iYear   0 lt { /r false def } if  % year can be anything from 00 to end of time, so only ge 0
      } if
    } { pop /r false def } ifelse % not a string
    r
  end
} bind def
% END OF :isDateString ______________________________________________________

% SetFontX DEF % dict SetFontX -
% << /s 12 /f /Imago-Book [ /colortype (k) /color [ 0 ] ] >> SetFontX -> set size and font
% 12 SetFontX -> set size and default font
/SetFontX {
  4 dict begin
    :integer{/i exch def << /s i >>}if
    /fontxdict exch def
    % default
    fontxdict length 0 eq{
      fontxdict /s 12 put
      fontxdict /colortype (k) put
      fontxdict /color [0] put
    }if
    fontxdict /superscriptsize :known not { fontxdict /superscriptsize defaultSuperscriptsize put } if
    fontxdict /superscript-y   :known not { fontxdict /superscript-y defaultSuperscriptsize   put } if
    fontxdict /f known not{
      fontxdict /f FontName:Default put
    }if
    fontxdict /s known fontxdict /f known and{
      fontxdict /s get :array {
        fontxdict /f get findfont exch makefont setfont
      }{
        fontxdict /f get findfont exch scalefont setfont
      } ifelse
    }if
    fontxdict /colortype known fontxdict /color known and{
      fontxdict SetColorX
    }if
    % Save the font as currentLocalFont in userdict
    userdict /currentLocalFont 10 dict put
    fontxdict currentLocalFont copy pop
  end
} bind def
% END OF SetFontX ______________________________________________________

/FontName:Current {
  currentfont /FontName get
} bind def
% END OF FontName:Current ______________________________________________________

/FontSize:Current {
  currentfont /ScaleMatrix get 0 get
} bind def
% END OF FontSize:Current ______________________________________________________

/FontIndex:Current 0 def
% END OF FontIndex:Current ______________________________________________________

/FontSize-Change {
  2 dict begin
    /size exch def
    currentLocalFont /s size put
    currentLocalFont SetFontX
  end
} bind def
% END OF FontSize-Change ______________________________________________________

% SetColorX DEF % dict SetColorX -
% << /colortype (k) /color [0] >> SetColorX % black
% << /colortype (hsb) /color [240 100 100] >> SetColorX % blue
% << /colortype (cmyk) /color [46 77 0 30] >> SetColorX % purple
% << /colortype (rgb) /color [0 255 157] >> SetColorX % light green
/SetColorX {
  6 dict begin
    /colorxdict exch def
    % default
    colorxdict length 0 eq{
      colorxdict /colortype (k) put
      colorxdict /color [0] put
    }if
    false setoverprint
    colorxdict /overprint known{
      colorxdict /overprint get setoverprint
    }if
    colorxdict /colortype known colorxdict /color known and{
      colorxdict begin
        /ctype colortype ToLower 0 get def
        ctype (k) 0 get eq ctype (g) 0 get eq ctype (b) 0 get eq or or{
          color 0 get setgray
        }if
        ctype (c) 0 get eq{
          color 0 get 100 div color 1 get 100 div color 2 get 100 div color 3 get 100 div setcmykcolor
        }if
        ctype (h) 0 get eq{
          color 0 get 360 div color 1 get 100 div color 2 get 100 div sethsbcolor
        }if
        ctype (r) 0 get eq{
          color 0 get 255 div color 1 get 255 div color 2 get 255 div setrgbcolor
        }if
        ctype (p) 0 get eq{
          % Pantone
          colorxdict /separation known colorxdict /tint known colorxdict /tinttransform known and and{
            %colorxdict /separation get /separation exch def
            %colorxdict /tinttransform get /tinttransform exch def
            %colorxdict /tint get /tint exch def
            %[ tinttransform{ tint mul }forall ] /cmyk exch def
            %[/Separation separation /DeviceCMYK {pop 0 0 0 0} dup 1 cmyk putinterval] setcolorspace tint setcolor
            colorxdict begin
              tint [tinttransform separation] SetPantone
            end
          }{
            .5 setgray
          }ifelse
        }if
      end
    }if
  end
} def % dont bind def
% END OF SetColorX ______________________________________________________
%
% Pantone Color Procedures (use instead of SetColorX) ________________________________
%       /tint .24 def
%       tint [[1 0.57 0 0.4] (PANTONE 295 C)] SetPantone
/SetPantone {
  SetPantoneSpace setcolor
} def
% END OF SetPantone ______________________________________________________

/SetPantoneSpace {
  /pa exch def
  [
    /Separation pa 1 get
    /DeviceCMYK { 0 { 1 index mul exch}forall pop}dup 0 pa 0 get put ] setcolorspace
} def
% END OF SetPantoneSpace ______________________________________________________
% ____________________________________________________________________________________

% SetLineX DEF % dict SetLineX -
% << /w .2 [ /l 2 ] [ /colortype (k) /color [ 0 ] ] >> SetLineX % thin
/SetLineX {
  2 dict begin
    /linexdict exch def
    % default
    0 setlinecap
    0 setlinejoin
    [] 0 setdash
    linexdict length 0 eq{
      linexdict /w 0 put
      linexdict /colortype (k) put
      linexdict /color [0] put
    }if
    linexdict /w known{
      linexdict /w get setlinewidth
    }if
    linexdict /lc known{
      linexdict /lc get setlinecap
    }if
    linexdict /j known{
      linexdict /j get setlinejoin
    }if
    linexdict /dash known{
      /dashoffset 0 def
      linexdict /dashoffset known{
        /dashoffset linexdict /dashoffset get def
      }if
      linexdict /dash get dashoffset setdash
    }if
    linexdict /colortype known linexdict /color known and{
      linexdict SetColorX
    }if
  end
} bind def
% END OF SetLineX ______________________________________________________

% FillX DEF % dict FillX -
% << /x 0 /y 0 /w 4 /h 2 /colortype (k) /color [ 0 ] >> FillX
/FillX {
  /fillxdict exch def
  fillxdict SetColorX
  fillxdict begin
    x y w h rectfill
  end
} bind def
% END OF FillX ______________________________________________________

  % Auto SuperScript based on Font-Index
  % Multiple Alt Fonts based on Index

% Show text with indicated alignment and return to previous currentpoint.  Use current font and size or pass delegate {show}
% Align Type is 3x3 grid representing currentpoint relation to text (eg, 7-lower left = show at currentpoint; 5-middle box = center text vertically and horizontally to currentpoint)
% ShowAlign DEF % (text) aligntype ShowAlign -
% ShowAlign DEF % (text) aligntype delegate ShowAlign -
/ShowAlign { %(ShowAlign) TRACE_BLOCK
  12 dict begin
    dup type /nametype eq{
      load
    }if
    dup xcheck{
      /String-Show-Delegate exch def
    }{
      /String-Show-Delegate {1 String-Show-Internal} def
    }ifelse
    /aligntype exch def
    /text exch def
    { /textstring text 255 string cvs def } stopped { /textstring (--ShowAlign text: value error or overflow--) def } if
    currentpoint /cy exch def /cx exch def
    textstring 0 String-Show-Internal /w exch def
    gsave
      textstring true charpath flattenpath pathbbox
      /URy exch def pop pop pop
      URy cy sub /h exch def
    grestore
    /x1 0 def
    /y1 0 def
    aligntype 1 eq aligntype 2 eq aligntype 3 eq or or{/y1 cy h sub def}if
    aligntype 4 eq aligntype 5 eq aligntype 6 eq or or{/y1 cy h 2 div sub def}if
    aligntype 7 eq aligntype 8 eq aligntype 9 eq or or{/y1 cy def}if
    aligntype 1 eq aligntype 4 eq aligntype 7 eq or or{/x1 cx def}if
    aligntype 2 eq aligntype 5 eq aligntype 8 eq or or{/x1 cx w 2 div sub def}if
    aligntype 3 eq aligntype 6 eq aligntype 9 eq or or{/x1 cx w sub def}if
    x1 y1 moveto
    textstring String-Show-Delegate
    cx cy moveto
  end
  %(ShowAlign) TRACE_BLOCK_EXIT
} bind def
% END OF ShowAlign ______________________________________________________

% DrawBoxAlign DEF % numx numy int int DrawBoxAlign -
% width length strokefilltype[0-2] (0-clip, 1-stroke, 2-fill) aligntype[1-9]
% use currently selected color for fill
/DrawBoxAlign {
  12 dict begin
    /aligntype exch def
    /strokefilltype exch def
    /y exch def
    /x exch def
    currentpoint /cy exch def /cx exch def
    /x1 0 def
    /y1 0 def
    aligntype 1 eq aligntype 2 eq aligntype 3 eq or or{/y1 cy y sub def}if
    aligntype 4 eq aligntype 5 eq aligntype 6 eq or or{/y1 cy y 2 div sub def}if
    aligntype 7 eq aligntype 8 eq aligntype 9 eq or or{/y1 cy def}if
    aligntype 1 eq aligntype 4 eq aligntype 7 eq or or{/x1 cx def}if
    aligntype 2 eq aligntype 5 eq aligntype 8 eq or or{/x1 cx x 2 div sub def}if
    aligntype 3 eq aligntype 6 eq aligntype 9 eq or or{/x1 cx x sub def}if
    x1 y1 moveto
    x1 x add y1 lineto
    x1 x add y1 y add lineto
    x1 y1 y add lineto
    closepath
    strokefilltype 0 eq{
      x1 y1 x y rectclip
    }if
    strokefilltype 1 eq{
      stroke
    }if
    strokefilltype 2 eq{
      fill
    }if
    cx cy moveto
end
} bind def
% END OF DrawBoxAlign ______________________________________________________

/BoundingBoxClip{
  0 :x 0 :y moveto
  BoxWidth BoxHeight 0 7 DrawBoxAlign
  0 :x 0 :y moveto 1 setgray 0 setlinewidth 0 -0.001 rlineto stroke
} bind def
% END OF BoundingBoxClip ______________________________________________________

/BoundingBoxDraw{
  0 :x 0 :y moveto
  BoxWidth BoxHeight 0 7 DrawBoxAlign
} bind def
% END OF BoundingBoxDraw ______________________________________________________

/BoundingBoxFill{
  0 :x 0 :y moveto
  BoxWidth BoxHeight 0 7 DrawBoxAlign
} bind def
% END OF BoundingBoxFill ______________________________________________________

% FontBaseHeight DEF % string -> base height
/FontBaseHeight{
  gsave
    8 dict begin
      /s exch def
      0 0 moveto
      s true charpath flattenpath pathbbox
      /URy exch def
      /URx exch def
      /LLy exch def
      /LLx exch def
      /height URy def
      /base 0 def
        LLy 0 lt{/base LLy abs def}if
      base
      height
    end
  grestore
} bind def
% END OF FontBaseHeight ______________________________________________________

% FontMeasurements: << /f /fontname /s 10 >> -> FontMeasurements -> ()
/FontMeasurements{
  % /Ascender  33-255
  % /CapOvershoot   33-127
  % /CapHeight (X)
  % /CenterlineX  (X)
  % /BaselineOvershoot [$A-Z0-9,]
  % /Descender 33-255
  % /CenterlineX-CapOvershoot
  8 dict begin
    /d exch def
    /s33-255 () def
    33 1 255{
      /ix exch def
      /s ( ) def
      ix 127 lt ix 160 gt or{
        s 0 ix put
      }if
      /s33-255 s +=
    }for
    /s33-127 () def
    33 1 127{
      /ix exch def
      /s ( ) def
      ix 127 lt ix 160 gt or{
        s 0 ix put
      }if
      /s33-127 s +=
    }for
    /ABC123 ($ABCDEFGHIJKLMNOPQRSTUVWXYZ-0123456789,) def %$
    d /f known d /s known and{
      d SetFontX
      (XXX) FontBaseHeight
      /height exch def
      /base exch def
      d /CapHeight height :00^ put
      d /CenterlineX height 2 div :00^ put
      ABC123 FontBaseHeight
      /height exch def
      /base exch def
      d /BaselineOvershoot base :00^ put
      s33-127 FontBaseHeight
      /height exch def
      /base exch def
      d /CapOvershoot height :00^ put
      s33-255 FontBaseHeight
      /height exch def
      /base exch def
      d /Ascender height :00^ put
      d /Descender base :00^ put
      d /CenterlineX-CapOvershoot d /CapOvershoot get d /CenterlineX get sub put
    }if
  end
} bind def
% END OF FontMeasurements ______________________________________________________

/PIPE (|) def         % begin/end glyph delimiter
/BRACE_LEFT ({) def   % begin superscript
/BRACE_RIGHT (}) def  % end superscript
/BBAR (\246) def      % set alt font index:  (Â¦0Â¦Text in Default Font Â¦1Â¦Alt Font Text Â¦0Â¦...)
/FWD_SLASH (/) def    % remove slash from glyph literal
/REG (\256) def      % set alt font index:  (Â¦0Â¦Text in Default Font Â¦1Â¦Alt Font Text Â¦0Â¦...)

/ASTERISK (*) def
/CARET (^) def

/CTRL_CHAR {
  2 dict begin
    /s exch def
    s PIPE eq
    s BBAR eq or
    s BRACE_LEFT eq or
    s BRACE_RIGHT eq or
  end
} bind def
% END OF CTRL_CHAR ______________________________________________________

/translateGlyph {
  ({R}) ({|/registered|}) String-Replace
} def


% String-Show-Internal DEF % text mode -> String-Show-Internal => num
/String-Show-Internal { %(String-Show-Internal) TRACE_BLOCK
  /startingFont 10 dict def
  currentLocalFont startingFont copy pop
  8 dict begin
    /mode exch def  % 0-width | 1-show
    /text exch def
    /w 0 def
    /x 0 def
    /in_glyph false def
    /glyph () def
    /in_alt false def
    /in_super false def
    /text text translateGlyph def
    text ToStringArray{
      /s exch def
      s BRACE_LEFT eq{
        /in_super true def
      }if
      s BRACE_RIGHT eq{
        /in_super false def
      }if
      s PIPE eq{
        /in_glyph !=
      }if
      % set alt font
      s BBAR eq{
        /in_alt !=
      }{
        in_alt{
          % here set alt
        }if
      }ifelse
      in_super s BRACE_LEFT ne s NO_SUP not in_glyph not and and and{
        % here set super
        currentLocalFont /superscriptsize get FontSize-Change
        0 currentLocalFont /superscript-y get rmoveto
      }if
      % show string / add stringwidth
      in_glyph not in_alt not s CTRL_CHAR not and and{
        /w s StringWidthX x add +=
        mode 1 eq{
          currentLocalFont /tracking known {
            % If tracking is specified in the font use ashow
            /unitTrackingWidth (m) StringWidthX 1000 div def
            currentLocalFont /tracking get unitTrackingWidth mul 0
            s ashow
          } {
            s show
          } ifelse
        }if
      }if
      % compose glyph
      in_glyph{
        s FWD_SLASH ne s PIPE ne and{
          /glyph s +=
        }if
      }if
      % show glyph / add glyphwidth
      in_glyph not s PIPE eq and{
        mode 0 eq{
        % add glyphwidth
          gsave
            0 0 0 0 rectclip
            0 0 moveto
            glyph cvn glyphshow
            /w currentpoint pop x add +=
          grestore
          /glyph () def
        }{
          % show glyph
          glyph cvn glyphshow
          /glyph () def
        }ifelse
      }if
      in_super s BRACE_LEFT ne s NO_SUP not in_glyph not and and and{
        % here reset super
        startingFont SetFontX
        0 currentLocalFont /superscript-y get neg rmoveto
      }if
    }forall
    mode 0 eq{
      w %return width
    }if
  end
  %(String-Show-Internal) TRACE_BLOCK_EXIT
} bind def
% END OF String-Show-Internal ______________________________________________________

% ToDecimalString DEF % num places DecimalSeparator ToDecimalString -> string
/ToDecimalString {
  8 dict begin
    /separator exch def % (.)
    /places exch def
    /value exch def
    /result value ToString def
    value value cvi eq{
      value cvi /value exch def
      /result value ToString def
      places 0 gt{
        /result separator +=
        1 1 places{
          pop
          /result (0) +=
        }for
      }if
    }{
      1 1 places value :places sub{
        pop
        /result (0) +=
      }for
    }ifelse
    result (.) separator String-Replace
  end
} bind def
% END OF ToDecimalString ______________________________________________________

% _________________________________________________________________
% GradientFill usage - d_gradient_fill_xxxxx GradientFill
%   setup dict as follows
%   set /originY as y = 0 position
%   reset /tint for each bar to 0.10
%   set /l as bar height, (negative for negative values
%     eg: S16-Bars /l 32 put, S16-Bars /l -19 put)
%   set /originX as bar center position
%
% Example dictionaries
%       /d_gradient_fill_gray <<
%         % *** means fixed for template
%         /colortype (k) %               ***
%         /color [0.10]  % start at 10%  (reset to 0.10 for each use) ***
%         /tint 0.10     %               ***
%         /tintMax 0.85  % end at 85%    ***
%         /w 16.0        %               ***
%         /l -10         % height of bar
%         /originX 30     % center of bar
%         /originY 700    % y = 0 position***
%       >> def
%       /d_gradient_fill_pantone <<
%         /colortype (pantone)  %        ***
%         /color [2945]
%         /tint 0.10     % start at 10%  (reset to 0.10 for each use) ***
%         /separation (PANTONE 2945 C)
%         /tinttransform [1 0.45 0 0.14]
%         /tintMax 0.85  % end at 85%    ***
%         /w 16.0        %               ***
%         /l 10          % height of bar
%         /originX 30     % center of bar
%         /originY 700    % y = 0 position***
%       >> def
%
% Example calls
%       d_gradient_fill_pantone GradientFill    % First bar after setup
%       d_gradient_fill_pantone begin  /l -14 def /originX 60 def /tint 0.10 def end
%       d_gradient_fill_pantone GradientFill    % Second bar with new X and height
%
/GradientFill {  %(GradientFill{}) TRACE_BLOCK
  gsave
    10 dict begin
      /d exch def
      d begin   % /d_gradient_fill_xxxxx
        /solidbars tint tintMax eq def
        l 0 ne { % Prevent divide by 0
          /incY 0.1 def
          incY 0.06 add setlinewidth                     % Removes blank pixels between lines
          /_originX  originX w 2 div sub def                % center on  originX
          solidbars not {
            _originX  originY translate                       % translate left, 0 corner
            l 0 lt { 180 rotate w neg 0 translate } if
          } if
          /_l l abs def
          /_colorRange tintMax tint sub def        % _colorRange = 0.85 - 0.10 = 0.75
          /_colorInc _colorRange _l div incY mul def  % _colorInc = 0.75 / 50 = 0.015
          /pantoneColor colortype 0 get (p) eq def
          /tintToColor { } def  % Pantone, cmyk
          colortype (k) eq {
            % Gray
            /color mark 1 tint sub ] def  % Gray: color = 1 - 0.10 = 0.90  intial color
            /tintToColor { /color mark 1 tint sub ] def } def
          } if
          /_ypos 0 def
          tint tintMax eq {
            % ____________ FillX _________________________________________________________
            colortype (pantone) eq {
              tint [tinttransform separation] SetPantone
            } {
              d SetColorX
            } ifelse
            /x _originX def
            /y  originY  def
            /h l      def
            d FillX
          }{
            % ____________ loop _________________________________________________________
            {
              gsave
                colortype (pantone) eq {
                  tint [tinttransform separation] SetPantone
                } {
                  d SetColorX
                } ifelse
                0 _ypos moveto
                w 0 rlineto
                stroke
                /_ypos _ypos incY add def
                d /tint tint _colorInc add put
                tintToColor                          % (1 - tint) for Gray, no-op for Pantone
              grestore
              _ypos _l gt { exit } if
            } loop
          } ifelse
          % ________________________________________
        } if
      end
    end
  grestore
  %(GradientFill{}) TRACE_BLOCK_EXIT
} def
% END OF GradientFill ____________________________________________

% text String-FootnoteSplit --> [ rawText primaryText footnote ]
/String-FootnoteSplit {  %(String-FootnoteSplit) TRACE_BLOCK
  10 dict begin
    /rawText exch def
    /tmpSplit ({) rawText StringSplit def
    /primaryText tmpSplit 0 get def
    tmpSplit length 2 ge {
      /footnote tmpSplit 1 get (}) () String-Replace def
    } {
      /footnote () def
    } ifelse
    [ rawText primaryText footnote ]
  end
} def
% END OF String-FootnoteSplit ____________________________________________

% --------------------------------------------------------------------------
%                            END OF Local lib
% --------------------------------------------------------------------------




% ErrorCode: 0 - test
% ErrorCode: 1 - info
% ErrorCode: 2 - warnings
% ErrorCode: 3+ - errors

/Error-Handler-Initialize {
  Error-Dictionary begin
    /ErrorCode 0 def
    /Message () def
    /Current-Error-Condition false def
    /Count-Total 0 def
    /Count-Type-Warning 0 def
    /Count-Type-Error 0 def
    /Current-Text () def
    /Error-Info [] def
    /Error-Info-Item [] def
    /ParameterInfo () def
    /first false def
    /last false def
    /test false def
  end
} bind def
% END OF Error-Handler-Initialize ______________________________________________________
% ______________________________________________________________________________________

/Error-Dictionary-Update{
  Error-Dictionary begin
    /first Count-Type-Error 0 eq ErrorCode 3 ge and def
    /last ErrorCode 3 ge def
    /test ErrorCode 0 eq def
    ErrorCode 3 ge{/Current-Error-Condition true def}if
    /Count-Total ++
    ErrorCode 2 eq{/Count-Type-Warning ++}if
    ErrorCode 3 ge{/Count-Type-Error ++}if
    mark
    Message
    ParameterInfo length 0 ne CommandInfo length 0 ne or{(: )}{()}ifelse
    CommandInfo
    ParameterInfo length 0 ne CommandInfo length 0 ne and{( : )}{()}ifelse
    ParameterInfo
    LocationInfo length 0 ne {mark ( \() LocationInfo (\)) ConcatToMark}{()}ifelse
    ConcatToMark
    /Current-Text exch def
    /Error-Info-Item [
      ErrorCode
      Message
      CommandInfo
      ParameterInfo
      LocationInfo
      first
      last
      test
      Current-Text
    ] def
    % clear "last" flag
    Error-Info{
      6 false put
    }forall
    /Error-Info Error-Info-Item Array-Push
  end
} bind def
% END OF Error-Dictionary-Update ______________________________________________________
% _____________________________________________________________________________________

/Error-Handler {
  Error-Dictionary begin
    /LocationInfo exch ToString def
    /ParameterInfo exch ToString def
    /CommandInfo exch ToString def
    /Message exch ToString def
    /ErrorCode exch def
  end
  Error-Dictionary-Update
} bind def
% END OF Error-Handler ______________________________________________________
% ___________________________________________________________________________

/Runtime-Error-Handler {
  /notepad << >> def
  notepad begin
    $error{
      def
    }forall
  end
  Error-Dictionary begin
    /LocationInfo () def
    /ParameterInfo (RuntimeError) def
    /CommandInfo notepad /command known{notepad /command get}{()}ifelse dup type /stringtype ne{cvlit MAX_STRING string cvs}if def
    /Message notepad /errorname known{notepad /errorname get}{()}ifelse dup type /stringtype ne{cvlit MAX_STRING string cvs}if def
    /ErrorCode 5 def
  end
  Error-Dictionary-Update
  Error-Dictionary begin
    notepad{
      def
    }forall
  end
} bind def
% END OF Runtime-Error-Handler ______________________________________________________
% ___________________________________________________________________________________

/Runtime-Error-Test {
  mark
  {
    /Hello World def
  }stopped{
    % Handle-Error
    Runtime-Error-Handler
  }if
  cleartomark
} bind def
% END OF Runtime-Error-Test ______________________________________________________
% ________________________________________________________________________________

/PostScript-Draw-Error {
  << /colortype (k) /color [.8] >> SetColorX
  0 :x 0 :y moveto
  BoxWidth BoxHeight 2 7 DrawBoxAlign
  /fontsizeheader 12 def
  /fontsizemessage 9 def
  /errctr 0 def
  /errmsg [] def
  Error-Dictionary /Error-Info get{
    /ea exch def
    ea 0 get 3 ge errctr 5 lt and{
      /errmsg ea 8 get Array-Push
      /errctr ++
    }if
  }forall
  << /s fontsizeheader >> SetFontX
  (Problem with Chart Data) StringWidthX /w1 exch def
  << /s fontsizemessage >> SetFontX
  errmsg{
    StringWidthX /w exch def
    w w1 gt{/w1 w def}if
  }forall
  /x1 BoxWidth 2 div w1 2 div sub :x def
  /x1 [x1 PageOriginX] :max def % long string
  /y1 BoxHeight 2 div errctr 10 mul 13 add 2 div add :y def
  << /colortype (k) /color [0] >> SetColorX
  << /s fontsizeheader >> SetFontX
  x1 y1 moveto
  (Problem with Chart Data) 4 ShowAlign
  << /s fontsizemessage >> SetFontX
  x1 y1 fontsizemessage 6 add sub moveto
  errmsg{
    4 ShowAlign
    x1 currentpoint exch pop fontsizemessage sub moveto
  }forall
  <</s 5>> SetFontX
  5 :x BoxHeight 5 sub :y moveto
  filename 1 ShowAlign
} bind def
% END OF PostScript-Draw-Error ______________________________________________________
% ___________________________________________________________________________________

/Measurements-Dictionary <<
	
>> def


/PostScript-Measurements{

  Measurements-Dictionary begin

    PostScript-Measurements-DataValidation

    PostScript-Measurements-Fixed

    PostScript-Measurements-Scale

    %PostScript-Measurements-Scale-Override

  end

} bind def
% END OF PostScript-Measurements ______________________________________________________
% _____________________________________________________________________________________


/ValidateColor {
  10 dict begin
    /colorString exch def
    /validColor false def
    colorString length 0 gt {
      colorString (K) eq {
        /validColor true def
      } {
        /pantoneParts (/) colorString StringSplit def
        % Check that pantone number is really a number
        pantoneParts length 1 gt {
          pantoneParts 1 get :isNumericString {
            /validColor true def
          } if
        } if
        validColor {
          % Check that tint, if present, is a number
          pantoneParts length 3 eq {
            pantoneParts 2 get :isNumericString {
              /validColor true def
            }{
               /validColor false def
            } ifelse
          } if
        } if
      } ifelse
    } if
    validColor
  end
} def

/PostScript-Measurements-DataValidation{
  % Bar color
  /BarColorSourceString datarr ValidateColor not {
      3 (Invalid Bar Color Specification) mark (") /BarColorSourceString datarr (") ConcatToMark () () Error-Handler
  } if
  :noerror {
    % Background color
    %/BackgroundColorSourceString datarr ValidateColor not {
    %    3 (Invalid Background Color Specification) mark (") /BackgroundColorSourceString datarr (") ConcatToMark () () Error-Handler
    %} if
    :noerror {
      % years sequential and in order
      /startLabels /Series-Labels 0 2 datarrval def
      /lastValue -1 def
      1 1 /Series-Labels datarr :n{
        /ix exch def
        /current /Series-Labels ix 2 datarrval def
        /location /Series-Labels ix 5 datarrval def
        % Allow same value as previous.
        % eg: ...2014, 2015, 2016, 2016 no error
        % eg: ...2014, 2015, 2016, 2015 error
        startLabels ix add current ne lastValue current ne and {
          3 (Invalid Series Data) () current location Error-Handler
        }if
        /lastValue current def
      }for
    } if
    :noerror {
    	% Y axis overrides
      /usingOverrides /S00-ValuesAxisOverride /override specdictvalue def
      usingOverrides {
      	% test for zero excluded
      	yincrement :isNumericString not{ 3 (Invalid Y-Axis Override Value) ()
          mark (ymin=') ymin ToString  (', ymax=') ymax ToString (', yincrement=') yincrement ToString (') ConcatToMark
          () Error-Handler
		    /overrideerror true def
		    }if
		    ymin :isNumericString not{ 3 (Invalid Y-Axis Override Value) ()
          mark (ymin=) ymin ToString  (, ymax=) ymax ToString ConcatToMark
          () Error-Handler
		    /overrideerror true def
		    }if
		    ymax :isNumericString not{ 3 (Invalid Y-Axis Override Value) ()
          mark (ymin=) ymin ToString  (, ymax=) ymax ToString ConcatToMark
          () Error-Handler
		    /overrideerror true def
		    }if
		ymax :isNumericString { ymin :isNumericString { yincrement :isNumericString {
		ymin cvi /qcmin exch def
		ymax cvi /qcmax exch def
		yincrement cvi /qcincrement exch def

		qcmin abs qcincrement div /qmin exch def
		qcmax qcincrement div /qmax exch def
		/overrideerror false def
		qmin qmin cvi ne{
		3 (Y-Axis Min Not Divisible) qcmin qcincrement () Error-Handler
		/overrideerror true def
		}if
		qmax qmax cvi ne{
		3 (Y-Axis Max Not Divisible) qcmax qcincrement () Error-Handler
		/overrideerror true def
		}if
		qcincrement 0 le{
		3 (Invalid Y-Axis Override Value) (Increment) qcincrement () Error-Handler
		/overrideerror true def
		}if
		qcmin qcmax gt {
		3 (Invalid Y-Axis Override Value) (ymin > ymax)
		mark qcmin ToString ( > ) qcmax ToString ConcatToMark
		() Error-Handler
		/overrideerror true def
		}if
    
		  0 ymin cvi ymax cvi bounds not {
			3 (Invalid Y-Axis Override Value) (0 excluded)
			mark (ymin=) ymin ToString  (, ymax=) ymax ToString ConcatToMark
			() Error-Handler
			/overrideerror true def
			}if
		}if }if }if
    } if    	
    } if
    :noerror {
    	% Y axis overrides
      /usingOverrides /S00-ValuesAxisOverride /override specdictvalue def
      usingOverrides {
      	% test min - max included
        /DataMinValue /Series-Values datarr {2 get} :min def
        /DataMaxValue /Series-Values datarr {2 get} :max def
      	DataMinValue ymin cvi ymax cvi bounds not 
      	DataMaxValue ymin cvi ymax cvi bounds not or
      	{
          3 (Invalid Y-Axis Override Value) (Y-Axis Override out of range)
          mark (ymin=) ymin ToString  (, ymax=) ymax ToString ConcatToMark
          () Error-Handler
          /overrideerror true def
      	} if
      } if    	
    } if
  } if
} bind def
% END OF PostScript-Measurements-DataValidation ______________________________________________________
% ____________________________________________________________________________________________________

    	% Handy reference
      % /:x { PageOriginX add } bind def /PageOriginX 0 def
      % /:y { PageOriginY add } bind def /PageOriginY 0 def

/PostScript-Measurements-Fixed {
    /ValuesAxisEndPoint BoxHeight /S07-ValuesAxis /origin specdictvalue sub	/S10-ValuesAxis-MarginTop /d specdictvalue sub def
    /ValuesAxisLength /S07-ValuesAxis /l specdictvalue def % yaxis line height
    /ValuesAxisOrigin /S04-SeriesAxisLabels-BottomMarginAlign /d specdictvalue /S04-SeriesAxisLabels-BottomMarginAlign /ybuffer specdictvalue add def
    /SeriesAxisOrigin /S05-ValuesAxis-MarginLeft /d specdictvalue def
    /SeriesAxisLength /S05-HorizontalRule /l specdictvalue def
    /SeriesAxisEndPoint SeriesAxisOrigin SeriesAxisLength add def                      
    /datalength /Series-Values datarr length def
  /Bars-Gap
    SeriesAxisLength
      /S04-Bars /w specdictvalue datalength mul
    sub
    datalength div
  def
  %/Bars-Gap /S13-Bars-Spacing /d specdictvalue def    % 14.578 Praxis
                                                                   % Shown for datalength = 10
  /SeriesStepLength /S04-Bars /w specdictvalue Bars-Gap add def    % SeriesStepLength=(23.5 + 14.578)=38.078 Praxis
  /SeriesStepCenterline SeriesStepLength 2 div def
  /TotalSeriesArea SeriesStepLength datalength mul def             % 72.5 * 3 = 217.5
  %/SeriesStepInitialOffset Bars-Gap 2 div def                      % 36.25
  %/SeriesStepInitialOffset 11 datalength sub SeriesStepLength mul Bars-Gap 2 div sub def
  /SeriesStepInitialOffset /S05-ValuesAxis-MarginLeft /d specdictvalue def
} bind def
% END OF PostScript-Measurements-Fixed ______________________________________________________
% ___________________________________________________________________________________________

/PostScript-Measurements-Scale{   %(PostScript-Measurements-Scale) TRACE_BLOCK
  /S00-ValuesAxisOverride specdict /override get /usingOverrides exch def
  /Series-Values datarr {2 get} :min /DataMinValue exch def
  /Series-Values datarr {2 get} :max /DataMaxValue exch def
  /ZeroValueNonEmpty false def
  /Series-Values datarr{
    /data exch def
    data 2 get 0 eq data 1 get ([]) ne and{
      /ZeroValueNonEmpty true def
    }if
  }forall
  /OverrideMinValue /S00-ValuesAxisOverride /ymin specdictvalue def
  /OverrideMaxValue /S00-ValuesAxisOverride /ymax specdictvalue def
  usingOverrides {
    /SeriesMinValue [DataMinValue OverrideMinValue 0] :min def
    /SeriesMaxValue [DataMaxValue OverrideMaxValue 0] :max def
  }{
    /SeriesMinValue DataMinValue def
    /SeriesMaxValue DataMaxValue def
  } ifelse
  /AllPositive SeriesMinValue 0 ge def
  /AllNegative SeriesMaxValue 0 lt def
  AllPositive AllNegative and {
    % Set up 0 value business rules minimum 0% to 3%, inc 1
    /ValuesAxisIncrement /Spec06-ValuesAxisIncrements /arr specdictvalue 0 get def
    /StepsPrefDifference 4 def
    /UsedSpacePercentage 0.873333 def
    /StepsPositive /Spec07-ValuesAxisLabels /min  specdictvalue 1 sub def
    /StepsNegative 0 def
    /TotalSteps /Spec07-ValuesAxisLabels /min  specdictvalue 1 sub def
    /TotalLabels /Spec07-ValuesAxisLabels /min  specdictvalue def
    /StepHeight ValuesAxisLength TotalSteps div def
    /DecimalPlaces 2 def
    /ZeroLineOffset 0.0 def
  }{
    /stepsmin  /Spec07-ValuesAxisLabels /min  specdictvalue 1 sub def
    /stepsmax  /Spec07-ValuesAxisLabels /max  specdictvalue 1 sub def
    /stepspref /Spec07-ValuesAxisLabels /pref specdictvalue 1 sub def
    %/MinInc    /Spec06-ValuesAxisIncrements /minInc specdictvalue def
    %SeriesMinValue abs MinInc lt SeriesMaxValue abs MinInc lt and { /stepspref stepsmin def } if
    /ValuesAxisIncrement 0 def
    /StepsPrefDifference 0 def
    /UsedSpacePercentage 0 def
    %/posmargin /S02-SeriesValuesLabels-MarginBottom /d specdictvalue def
    /posmargin
      /S02-SeriesValuesLabels-MarginBottom /d specdictvalue      % 3.4 + 5.1 + 1.5 = 10.0
      /S01-SeriesValuesLabels /capHeight specdictvalue
      1.5 add
      add
    def
    /negmargin /S07-SeriesValuesLabelsNegative-BottomMarginAlign /d specdictvalue def   % 9.3
    /totalmarginPos posmargin def
    %/totalmarginNeg 0 def       % Is 0 because negative bars get their value string on top
    /totalmarginNeg negmargin 0.6 add def
    /Spec06-ValuesAxisIncrements /arr specdictvalue /arr exch def
    arr :n -1 0{
      /ix exch def
      /inc arr ix get def
      stepsmax -1 1{
        /stepspos exch def
        AllNegative { /stepspos 0 def } if
        stepsmax -1 1{
          /stepsneg exch def
          AllPositive { /stepsneg 0 def } if
          /valid false def
          SeriesMinValue 0 eq SeriesMaxValue 0 eq xor{
            SeriesMaxValue 0 eq{/stepspos 1 def}if
            SeriesMinValue 0 eq{/stepsneg 0 def}if
          }if
          SeriesMinValue 0 eq SeriesMaxValue 0 eq and{
            SeriesMinValue 0 eq{/stepsneg 0 def}if
          }if
          /stepstotal stepspos stepsneg add def
          /stepheight ValuesAxisLength stepstotal div def
          /totalposheight stepspos stepheight mul def
          /totalnegheight stepsneg stepheight mul def
          /maxposheight [totalposheight totalmarginPos sub 0] :max def
          /maxnegheight [totalnegheight totalmarginNeg sub 0] :max def
          /totalpos stepspos inc mul def
          /totalneg stepsneg inc mul def
          /percpos totalpos :nonzero{SeriesMaxValue exch div}if def
          /percneg totalneg :nonzero{SeriesMinValue abs exch div}if def
          /heightpos percpos totalposheight mul def
          /heightneg percneg totalnegheight mul def
          heightpos maxposheight le heightneg maxnegheight le stepstotal stepsmin stepsmax bounds and and{
            % potential valid
            /valid true def
            /currentsteps stepstotal def
            /currentinc inc def
            /currentscore currentsteps stepspref sub abs def
            /perctotal percpos percneg add def
            ValuesAxisIncrement 0 eq{
              /ValuesAxisIncrement currentinc def
              /StepsPrefDifference currentscore def
              /UsedSpacePercentage perctotal def
              /StepsPositive stepspos def
              /StepsNegative stepsneg def
              /TotalSteps stepstotal def
            }if
          }if
          valid{
            /updatevalues false def
            % lower scale only when space maximization and not label preference less optimal
            ValuesAxisIncrement currentinc eq{
              % maximize space for current increment
              perctotal UsedSpacePercentage ge{
                /updatevalues true def
              }if
            }{
              % maximize label count preference
              perctotal UsedSpacePercentage ge currentscore StepsPrefDifference le and{
                /updatevalues true def
              }if
            }ifelse
            updatevalues{
              /topPosition stepheight stepspos mul def
              /topPositionWithText topPosition /S01-SeriesValuesLabels /capHeight specdictvalue 10 add add def
              /ValuesAxisIncrement currentinc def
              /StepsPrefDifference currentscore def
              /UsedSpacePercentage perctotal def
              %topPositionWithText topPosition gt {
              %  /stepspos stepspos 1 add def
              %} if
              /StepsPositive stepspos def
              /StepsNegative stepsneg def
              %topPositionWithText topPosition gt {
              %  /stepstotal stepstotal 1 add def
              %} if
              /TotalSteps stepstotal def
            }if
          }if
        }for       % stepsneg
      }for       % stepspos
    }for       % increments
    ValuesAxisIncrement 0 gt{
      /TotalLabels TotalSteps 1 add def
      /StepHeight ValuesAxisLength TotalSteps div def
      %/DecimalPlaces ValuesAxisIncrement :places def
      /DecimalPlaces 2 def
      /ZeroLineOffset StepsNegative StepHeight mul def
    }{
      % No error if Override:
      /S00-ValuesAxisOverride /override specdictvalue not{
        3 (Scale Not Found) SeriesMinValue SeriesMaxValue () Error-Handler
      }if
    } ifelse
  } ifelse  % Minimum business rules
  ValuesAxisIncrement 0.5 eq { /DecimalPlaces 0 def } if
  PostScript-Measurements-Scale-simple
  %(PostScript-Measurements-Scale) TRACE_BLOCK_EXIT
} bind def
% END OF PostScript-Measurements-Scale ______________________________________________________
% ___________________________________________________________________________________________

/PostScript-Measurements-Scale-simple {
  /S00-ValuesAxisOverride /override specdictvalue {
    /ymin /S00-ValuesAxisOverride /ymin specdictvalue def
    /ymax /S00-ValuesAxisOverride /ymax specdictvalue def
    /SeriesMinValue ymin def
    /SeriesMaxValue ymax def
  } if
  ymin ymax gt {
    3 (Invalid Y-Axis Override Value) (ymin > ymax)
       mark ymin ToString ( > ) ymax ToString ConcatToMark
       () Error-Handler
    /overrideerror true def
  }if
  
  % ALL POSITIVE 
  AllPositive AllNegative not and {
    /labeloffset 1 def
    SeriesMaxValue 0 eq { /ScaleFactor ValuesAxisLength def } {
    /ScaleFactor ValuesAxisLength TotalSteps ValuesAxisIncrement mul div def
    } ifelse
    /ZeroLineOffset /S04-SeriesAxisLabels-BottomMarginAlign /d specdictvalue /S04-SeriesAxisLabels-BottomMarginAlign /ybuffer specdictvalue add def
    /ValuesAxisOrigin /S04-SeriesAxisLabels-BottomMarginAlign /d specdictvalue def
  } if
  
  % ALL NEGATIVE
  AllPositive not AllNegative  and {
    /labeloffset 1 def   
    /ScaleFactor ValuesAxisLength TotalSteps ValuesAxisIncrement mul div def
    /ZeroLineOffset /S07-ValuesAxis /l specdictvalue /S04-SeriesAxisLabels-BottomMarginAlign /d specdictvalue add /S04-SeriesAxisLabels-BottomMarginAlign /ybuffer specdictvalue add def
    /ValuesAxisOrigin BoxHeight 7.8 sub def
  } if
  
  % MIXED POSITIVE AND NEGATIVE
  AllPositive not AllNegative not and {
    /ValuesAxisOrigin /S04-SeriesAxisLabels-BottomMarginAlign /d specdictvalue /S04-SeriesAxisLabels-BottomMarginAlign /ybuffer specdictvalue add def
  	/ValuesAxisLength ValuesAxisLength def
    /labeloffset 1 def    
    /ScaleFactor ValuesAxisLength TotalSteps ValuesAxisIncrement mul div def    
    /ZeroLineOffset ZeroLineOffset /S04-SeriesAxisLabels-BottomMarginAlign /d specdictvalue add /S04-SeriesAxisLabels-BottomMarginAlign /ybuffer specdictvalue add def
  } if
  % This is the "all zero" case
  
  AllPositive AllNegative and {
    /labeloffset 1 def
    /ZeroLineOffset 0 def
    /SeriesMinValue 0 def
    /SeriesMaxValue 2 def   
    /ScaleFactor ValuesAxisLength TotalSteps ValuesAxisIncrement mul div def
    /ZeroLineOffset SeriesMinValue abs ScaleFactor mul def
  } if
} bind def
% END OF PostScript-Measurements-Scale-simple _______________________________________________
% ___________________________________________________________________________________________

%/PostScript-Measurements-Scale-Override{
%  /S00-ValuesAxisOverride /override specdictvalue{ % if override
%    /ymin /S00-ValuesAxisOverride /ymin specdictvalue def
%    /ymax /S00-ValuesAxisOverride /ymax specdictvalue def
%    /yincrement /S00-ValuesAxisOverride /yincrement specdictvalue def
%    ymin abs yincrement div /qmin exch def
%    ymax yincrement div /qmax exch def
%    /overrideerror false def
%    qmin qmin cvi ne{
%      3 (Y-Axis Min Not Divisible) ymin yincrement () Error-Handler
%      /overrideerror true def
%    }if
%    qmax qmax cvi ne{
%      3 (Y-Axis Max Not Divisible) ymax yincrement () Error-Handler
%      /overrideerror true def
%    }if
%    yincrement 0 le{
%      3 (Invalid Y-Axis Override Value) (Increment) yincrement () Error-Handler
%      /overrideerror true def
%    }if
%    ymin ymax gt {
%      3 (Invalid Y-Axis Override Value) (ymin > ymax)
%         mark ymin ToString ( > ) ymax ToString ConcatToMark
%         () Error-Handler
%      /overrideerror true def
%    }if
%    overrideerror not{
%      % Set Override Values:
%      /ValuesAxisIncrement yincrement def
%      /StepsPositive qmax cvi def
%      /StepsNegative qmin cvi def
%      /TotalSteps StepsPositive StepsNegative add def
%      /TotalLabels TotalSteps 1 add def
%      /StepHeight ValuesAxisLength TotalSteps div def
%      %/DecimalPlaces ValuesAxisIncrement :places def
%      /DecimalPlaces 2 def
%      /ZeroLineOffset StepsNegative StepHeight mul def
%      % Validate min/max values including label height:
%      /posmargin /S02-SeriesValuesLabels-MarginBottom /d specdictvalue def
%      /negmargin /S07-SeriesValuesLabelsNegative-BottomMarginAlign /d specdictvalue def
%      /totalmargin posmargin negmargin add def
%      StepsPositive 0 gt{
%        /BarMargin
%          /S01-SeriesValuesLabels /capHeight specdictvalue
%          /S02-SeriesValuesLabels-MarginBottom /d specdictvalue
%          add
%        def
%        /ZeroHeight StepsPositive StepHeight mul def
%        /BarMaxHeight ZeroHeight BarMargin sub def
%        /total StepsPositive ValuesAxisIncrement mul def
%        /perc SeriesMaxValue total div def
%        /height perc ZeroHeight mul def
%        height BarMaxHeight gt{
%          3 (Invalid Y-Axis Max Value) () SeriesMaxValue () Error-Handler
%        }if
%      }if
%      StepsNegative 0 gt{
%        /ZeroHeight StepsNegative StepHeight mul def
%        /BarMaxHeight ZeroHeight totalmargin sub def
%        /total StepsNegative ValuesAxisIncrement mul def
%        /perc SeriesMinValue abs total div def
%        /height perc ZeroHeight mul def
%        height BarMaxHeight gt{
%          3 (Invalid Y-Axis Min Value) () SeriesMinValue () Error-Handler
%        }if
%      }if
%      % edge case - override with zero positive steps and non-empty zero value
%      StepsPositive 0 eq ZeroValueNonEmpty and{
%        3 (Invalid Y-Axis Max Value) ymax data 1 get data 5 get Error-Handler
%      }if
%    }if
%    % Test for zero value contained in Y-Axis values
%    overrideerror not {
%      /hasZero false def
%      ymin yincrement ymax {
%        /val exch def
%        val 0 eq { 
%          /hasZero true def
%          exit
%        } if 
%      } for
%      hasZero not {
%        3 (Invalid Y-Axis Override Values)
%        (Does not contain 0)
%        mark
%          (ymin=) ymin ToString
%          (, yinc=) yincrement ToString
%          (, ymax=) ymax ToString
%        ConcatToMark
%        ()
%        Error-Handler
%      }if
%    } if
%  }if
%} bind def
% END OF PostScript-Measurements-Scale-Override ______________________________________________________
% ____________________________________________________________________________________________________

/PostScript-Draw{
  Measurements-Dictionary begin

    PostScript-Draw-BoundingBox

    PostScript-Draw-Scale

    PostScript-Draw-Bars

    PostScript-Draw-ZeroLine

    %PostScript-Draw-Legends

  end
} bind def

/PostScript-Draw-BoundingBox{
  %/S08-BoundingBox specdict SetColorX
  %BoundingBoxDraw
  /S08-BoundingBox /filled specdictvalue {
    /backgroundColorDict 10 dict def
    /S08-BoundingBox specdict backgroundColorDict copy pop
    /colorSourceParts (/) Data-Dictionary /BackgroundColorSourceString get StringSplit def
    /colorSourcePartsLength colorSourceParts length def
    colorSourcePartsLength 0 gt { /colorSpace colorSourceParts 0 get ToUpper def }{ /colorSpace (K) def } ifelse
    % __________________________________________________
    colorSpace (K) eq {
      % GRAY
      backgroundColorDict begin
        /colortype (K) def
        colorSourceParts length 2 eq {
          % has tint
        /color mark colorSourceParts 1 get cvr 100.0 div 1 exch sub ] def
        } if
      end
    } if
    % __________________________________________________
    colorSpace (CMYK) eq {
      % CMYK
        backgroundColorDict begin
          /colortype (cmyk) def
          colorSourcePartsLength 6 eq {
            % has tint
            /tint colorSourceParts 5 get cvr 100.0 div def
            /tintMax tint def
          } if
          /color [
            colorSourceParts 1 get cvr tint mul
            colorSourceParts 2 get cvr tint mul
            colorSourceParts 3 get cvr tint mul
            colorSourceParts 4 get cvr tint mul
          ] def
        end
    } if
    % __________________________________________________
    colorSpace (PMS) eq {
      % Pantone
      /BackgroundColor datarr 0 get /d_tmp exch def
      backgroundColorDict begin
        /colortype (pantone) def
        /color [ d_tmp 0 get ] def
        /separation d_tmp 5 get def
        /tinttransform [ d_tmp 1 get  d_tmp 2 get d_tmp 3 get d_tmp 4 get ] def
        colorSourceParts length 3 eq {
          /tint colorSourceParts 2 get cvr 100.0 div def
          /tintMax tint def
        } if
      end
    } if
    % __________________________________________________
    backgroundColorDict FillX 
  } if
}bind def
% END OF PostScript-Draw-BoundingBox ______________________________________________________
% _________________________________________________________________________________________

% NOT USED
%/PostScript-Draw-Legends{
%  /S02-ValuesAxis-VerticalLegend specdict SetFontX
%  /S03-ValuesAxis-VerticalLegend-RightMarginAlign /d specdictvalue :x ValuesAxisOrigin ValuesAxisLength :half add :y moveto
%  gsave
%    90 rotate
%    ValuesAxisVerticalLegend 8 ShowAlign
%  grestore
%  /S09-ChartTitle specdict SetFontX
%  BoxWidth :half :x BoxHeight /S08-ChartTitle-BottomMarginAlign /d specdictvalue sub :y moveto
%  ChartTitle 8 ShowAlign
%  /S20-SeriesAxisLegend specdict SetFontX
%  BoxWidth :half :x ValuesAxisOrigin /S19-SeriesAxisLegend-BottomMarginAlign /d specdictvalue sub :y moveto
%  SeriesAxisLegend 8 ShowAlign
%}bind def
%% END OF PostScript-Draw-Legends ______________________________________________________


/PostScript-Draw-Scale {
  % Horizontal Lines (used for debugging for this project)
  /S05-HorizontalRuleDebug /debug specdictvalue {
    0 1 TotalSteps{
      /step exch def
      /offset step StepHeight mul def
      step StepsNegative ne {
        /S05-HorizontalRuleDebug specdict SetLineX
        SeriesAxisOrigin :x ValuesAxisOrigin offset add :y moveto
        SeriesAxisEndPoint :x ValuesAxisOrigin offset add :y lineto stroke
      } if
    } for
  } if
  %
  %% Vertical tick marks
  %/S07-ValuesAxis specdict /tick known {
  %  0 1 TotalSteps{
  %    /step exch def
  %    /offset step StepHeight mul def
  %    /S07-ValuesAxis specdict SetLineX
  %    SeriesAxisOrigin :x ValuesAxisOrigin offset add :y moveto
  %    /S07-ValuesAxis /tick specdictvalue neg :x 0 :y rlineto stroke
  %  } for
  %} if
  %% Values Axis Labels
  /labeloffset /S02-ValuesAxisLabels-RightMarginAlign /d specdictvalue def
  /centerlinex /S01-ValuesAxisLabels /CenterlineX specdictvalue 1 add def
  /S01-ValuesAxisLabels specdict SetFontX
  
  labeloffset :x ZeroLineOffset centerlinex sub :y moveto            % y axis zero labels
  /language Locale 0 2 getinterval def
  
  %language (fr) eq language (FR) eq language (Fr) eq or or {
  
  /strPct (%) def
  
  %}{
  %  %/strPct (%) def
  %  /strPct () def
  %} ifelse
  %%/zeroString DecimalPlaces 1 eq { (0.0) }{ (0) } ifelse def
 /zeroString (0) def
  zeroString strPct ConcatX
  0 centerlinex rmoveto
  9 ShowAlign
   StepsNegative 0 eq { 0 0 } if %only positive  values
  1 1 StepsPositive{
   /step exch def
 /offset step StepHeight mul def
  /value ValuesAxisIncrement step mul def
  /value ValuesAxisIncrement step mul def
  /label value strPct ConcatX def
  %/label value DecimalPlaces DecimalSeparator ToDecimalString strPct ConcatX def
  labeloffset :x ZeroLineOffset offset add :y moveto
  label 9 ShowAlign
}for
 1 1 StepsNegative{
  /step exch def
  /offset step StepHeight mul def
  /value ValuesAxisIncrement step mul neg def
  % /label value DecimalPlaces DecimalSeparator ToDecimalString strPct ConcatX def
  /label value strPct ConcatX def
  labeloffset  :x ZeroLineOffset offset sub centerlinex 2 div add 2 sub :y moveto % negative y axis label
  %  %step StepsNegative eq { 0 /S07-ValuesAxis /extension specdictvalue rmoveto } if
  label 9 ShowAlign
 }for
  %% Perimeter box
  %gsave
  %  /S05-HorizontalRule specdict SetLineX
  %  SeriesAxisOrigin :x ValuesAxisOrigin :y
  %  SeriesAxisLength ValuesAxisLength
  %  rectstroke
  %grestore
  %gsave
  %  /centerTmp ValuesAxisLength 2 div /S07-ValuesAxis /zeroPoint specdictvalue add def
  %  /strtmp Data-Dictionary /Title get def
  %  /S03-Title specdict SetFontX
  %  /wTmp strtmp stringwidth pop def
  %  /xTmp centerTmp wTmp 2 div sub def
  %  /S03-Title /align specdictvalue xTmp moveto 90 rotate strtmp show
  %grestore
} bind def
% END OF PostScript-Draw-Scale ______________________________________________________
% ___________________________________________________________________________________


% Bars and tick marks
/PostScript-Draw-Bars { %(PostScript-Draw-Bars) TRACE_BLOCK
  /datalength /Series-Values datarr length def
  %/labeloffset /S04-SeriesAxisLabels-BottomMarginAlign /d specdictvalue def
  /barwidth /S04-Bars /w specdictvalue def
  /positivelabeloffset /S02-SeriesValuesLabels-MarginBottom /d specdictvalue def
  /negativelabeloffset positivelabeloffset def       % Negative and positive bar labels are above bars
  /topCapValue /S04-Bars /topCap specdictvalue def
  % Adjust for 11 bars
  datalength 11 eq {
    /Offset_11 9.5 def
  }{
    /Offset_11 0 def
  } ifelse
  /SeriesStepInitialOffset SeriesStepInitialOffset Offset_11 add def
  %_________________________________________________________
  %        set up gradient dictionary for bars
  % Pantone will look like this:
  %  /Color [
  %    [ ([2945 1 0.45 0 0.14 \(PANTONE 2945 C\)]) [2945 1 0.45 0 0.14 (PANTONE 2945 C)] (pantone) 0 ]
  %  ]
  %
  % /Color datarr length /colorlength exch def
  %_________________________________________________________
  /d_gradient_fill 10 dict def
  /S04-Bars specdict d_gradient_fill copy pop
  /colorSourceParts (/) Data-Dictionary /BarColorSourceString get StringSplit def
  /colorSourcePartsLength colorSourceParts length def
  colorSourcePartsLength 0 gt { /colorSpace colorSourceParts 0 get ToUpper def }{ /colorSpace (K) def } ifelse
  % __________________________________________________
  colorSpace (K) eq {
    % GRAY
    colorSourceParts length 2 eq {
      % has tint
      d_gradient_fill begin
        /tint colorSourceParts 1 get cvr 100.0 div def
        /tintMax tint def
      end
    } if
  } if
  % __________________________________________________
  colorSpace (CMYK) eq {
    % CMYK
      d_gradient_fill begin
        /colortype (cmyk) def
        colorSourcePartsLength 6 eq {
          % has tint
          /tint colorSourceParts 5 get cvr 100.0 div def
          /tintMax tint def
        } if
        /color [
          colorSourceParts 1 get cvr tint mul
          colorSourceParts 2 get cvr tint mul
          colorSourceParts 3 get cvr tint mul
          colorSourceParts 4 get cvr tint mul
        ] def
      end
  } if
  % __________________________________________________
  colorSpace (PMS) eq {
    % Pantone
    /BarColor datarr 0 get /d_tmp exch def
    d_gradient_fill begin
      /colortype (pantone) def
      /color [ d_tmp 0 get ] def
      /separation d_tmp 5 get def
      /tinttransform [ d_tmp 1 get  d_tmp 2 get d_tmp 3 get d_tmp 4 get ] def
      colorSourceParts length 3 eq {
        /tint colorSourceParts 2 get cvr 100.0 div def
        /tintMax tint def
      } if
    end
  } if
  % __________________________________________________
   d_gradient_fill /originY ZeroLineOffset :y put
  %_________________________________________________________
  0 1 datalength 1 sub{
    /i exch def
    /label        /Series-Labels i 1 datarrval def
    %/labelLength label length def                 % uncomment 2 lines for YY format 
    %/label        /Series-Labels i 1 datarrval 2 labelLength 2 sub getinterval def  % convert 2016 to 16
    /footnotepost /Series-Labels i 6 datarrval def
    /value        /Series-Values i 2 datarrval def
    /displayvalue        /Series-Values i 1 datarrval def
    /displayParts displayvalue String-FootnoteSplit def
    /display1 displayParts 1 get def
    displayParts 2 get length 0 gt {
      /display2 mark ({) displayParts 2 get (}) ConcatToMark def
    }{
      /display2 () def
    } ifelse
    value 0 ge {
      /display mark display1 (\%) display2 ConcatToMark def
    }{
      % /display mark (\() display1 (-) () String-Replace(\)\%) display2 ConcatToMark def % "(7.66)%*" format
      /display mark display1 (\%) display2 ConcatToMark def                               % "-7.66%*" format
    } ifelse
    /barcenterline
      SeriesAxisOrigin
      SeriesStepLength i mul add
      SeriesStepCenterline add
    def
    % Bars:
    /perc value abs ValuesAxisIncrement div 1.35 mul def
    %perc 1.4 mul StepHeight mul /height exch def
    /height ScaleFactor value abs mul def
    %/height perc StepHeight mul 1.28 mul def   % 16.8
    %/height perc StepHeight mul 1.35 mul def
    %
    % Draw bars with gradient
    display ([]%) ne{
      value 0 ge { /barVector 1 def } { /barVector -1 def } ifelse
      d_gradient_fill /originX barcenterline :x put % bar position
      d_gradient_fill /l height barVector mul put
      d_gradient_fill GradientFill
      %____________________________________________________________________
      d_gradient_fill begin
        %________________ topCaps ____________________
        false {
        /save_originY  originY def 
        /save_tint tint def
        /save_tintMax tintMax def
        /save_l l def
        l abs topCapValue ge {
        	l 0 le {
        		/l topCapValue def
        	  /originY originY save_l abs sub def %topCapValue add def
        	}{
        		/l topCapValue def
         	  /originY originY save_l add topCapValue sub def
         } ifelse
        } if
        /tint 1.0 def
        /tintMax 1.0 def
        d_gradient_fill GradientFill
        /originY save_originY def 
        /tint save_tint def
        /tintMax save_tintMax def
        /l save_l def
      } if
       %_____________________________________________
      end
      %% outline
      %/S08-Bar-Outline specdict SetLineX
      %barcenterline barwidth 2 div sub ZeroLineOffset /S07-ValuesAxis /zeroPoint specdictvalue add
      %barwidth height barVector mul
      %rectstroke
    }if
    % Data Labels:
    /S06-SeriesAxisLabels specdict SetFontX
    /stringcenterCorrect
      /S01-SeriesValuesLabels specdict /tracking known {
        % only if tracking is used
        /S01-SeriesValuesLabels /centerCorrect specdictvalue
        display length mul 2 mul
      }{
        0
      } ifelse
    def
    /S01-SeriesValuesLabels specdict SetFontX
    value 0 ge {
      % Positive value
     /labelTmpX barcenterline stringcenterCorrect add  :x def % bar label 
      AllNegative AllPositive and {
        /labelTmpY ValuesAxisOrigin ZeroLineOffset add /S07-SeriesValuesLabelsNegative-BottomMarginAlign /d specdictvalue sub height sub :y def
      }{
        /labelTmpY ZeroLineOffset height add positivelabeloffset add :y def
      } ifelse
      % ____________________________________________________________
      % Avoid horizontal rules _____________________________________
      %/labelTmpY exch def
      %value ValuesAxisIncrement CeilingX /nextHigher exch def
      %nextHigher abs ValuesAxisIncrement div /perc exch def
      %perc StepHeight mul ZeroLineOffset add ValuesAxisOrigin add /nextHigherX exch def
      %labelTmpY nextHigherX sub 1.2 lt
      %labelTmpY nextHigherX sub -5.2 gt and
      %{
      %  /labelTmpY nextHigherX 1.2 add def
      %} if
      labelTmpX labelTmpY moveto
      % ____________________________________________________________
    }{
      %barcenterline stringcenterCorrect add :x ValuesAxisOrigin ZeroLineOffset add height sub negativelabeloffset sub :y
      /labelTmpX barcenterline stringcenterCorrect  add :x def %negative barlabel
      % ____________________________________________________________
      % Avoid horizontal rules _____________________________________
      %/labelTmpY exch def
      %value ValuesAxisIncrement FloorX /nextLower exch def
      %nextLower ValuesAxisIncrement div /perc exch def
      %perc StepHeight mul ZeroLineOffset add ValuesAxisOrigin add /nextLowerX exch def
      %labelTmpY nextLowerX sub 0.6 lt
      %labelTmpY nextLowerX sub -5.0 gt and
      %{
      %  /labelTmpY nextLowerX 6.2 sub def
      %} if
      % _________________________________________________________________________
      % This project has labels above zero line for negative values
      %/labelTmpY ValuesAxisOrigin ZeroLineOffset add negativelabeloffset add :y def
      % _________________________________________________________________________
      % _________________________________________________________________________
      % This project has labels below bars for negative values
      %/labelTmpY ValuesAxisOrigin ZeroLineOffset add negativelabeloffset sub height sub :y def
        /labelTmpY ZeroLineOffset /S07-SeriesValuesLabelsNegative-BottomMarginAlign /d specdictvalue sub height sub :y def
      % ____________________________________________________________
      labelTmpX labelTmpY moveto
    }ifelse
    /S01-SeriesValuesLabels specdict SetFontX
    display ([]%) ne{
      display 8 ShowAlign
    }if
    % Series Labels: years
    /S06-SeriesAxisLabels specdict SetFontX
    barcenterline :x /S04-SeriesAxisLabels-BottomMarginAlign /ybuffer specdictvalue :y moveto
    label 8 ShowAlign
    barcenterline  :x ValuesAxisOrigin labeloffset sub 8.5 sub :y moveto
    footnotepost 8 ShowAlign   
  }for
  %(PostScript-Draw-Bars) TRACE_BLOCK_EXIT
} bind def
% END OF PostScript-Draw-Bars ______________________________________________________
% __________________________________________________________________________________

/PostScript-Draw-ZeroLine {  %(PostScript-Draw-ZeroLine) TRACE_BLOCK
  % Horizontal Rules Top / Bottom
  %0 TotalSteps TotalSteps {
  %  /step exch def
  %  /offset step StepHeight mul def
  %  step StepsNegative ne {
  %    /S05-HorizontalRule specdict SetLineX
  %    SeriesAxisOrigin :x ValuesAxisOrigin offset add :y moveto
  %    SeriesAxisEndPoint :x ValuesAxisOrigin offset add :y lineto stroke
  %  } if
  %} for
  %
 % Zero Lines
  %     Horizontal  
  /S05-HorizontalRule specdict SetLineX
  SeriesAxisOrigin  :x ZeroLineOffset :y moveto
  SeriesAxisEndPoint :x ZeroLineOffset :y lineto stroke %Horizontal line
  
  % Vertical - yaxis line
  /ValueAxisLineEnd /S07-ValuesAxis /l specdictvalue def
  /Downlimit /S04-SeriesAxisLabels-BottomMarginAlign /d specdictvalue /S04-SeriesAxisLabels-BottomMarginAlign /ybuffer specdictvalue add def
  /S07-ValuesAxis specdict SetLineX
  %SeriesAxisOrigin :x ValuesAxisOrigin Upperlimit sub :y moveto
  %SeriesAxisOrigin :x ValuesAxisEndPoint :y lineto stroke
  SeriesAxisOrigin :x Downlimit :y moveto % 30.1 : x 129: y
  SeriesAxisOrigin :x ValueAxisLineEnd Downlimit add :y lineto stroke
  
  
  
  % Series tick marks
  /S05-HorizontalRule specdict /tick known {
    /tickLength
      /S05-HorizontalRule /tick specdictvalue
      %/S05-HorizontalRule /w specdictvalue 2 div
      %add
    def
    /S05-HorizontalRule /w specdictvalue setlinewidth
    /x SeriesAxisOrigin def         
     %/y ValuesAxisOrigin def         
    /y ZeroLineOffset ValuesAxisOrigin add def        
    /xinc SeriesStepLength def
    10 {
      x y moveto
      x y tickLength sub lineto stroke
      /x x xinc add def
    } repeat
  } if
  
  %(PostScript-Draw-ZeroLine) TRACE_BLOCK_EXIT
} bind def
% END OF PostScript-ZeroLine ______________________________________________________
% _________________________________________________________________________________

/Main {

  BoundingBoxClip

  % Runtime-Error-Test

  {
    :noerror{
      PostScript-Measurements
    }if
    :noerror{
      PostScript-Draw
    }if
  }stopped{
    % Handle-Error
    Runtime-Error-Handler
  }if

  :error{
    PostScript-Draw-Error
  }if

} bind def

 
