%%EndData
%%EndResource
% Define setcmykcolor as rgb if setcmykcolor not available.
/setcmykcolor where { flush pop }
{
  version cvr 38.0 le
  { /fixedsetrgbcolor
      { currenttransfer exec 3 1 roll
       currenttransfer exec 3 1 roll
       currenttransfer exec 3 1 roll
       setrgbcolor
      } bind def
  }
  { /fixedsetrgbcolor { setrgbcolor } bind def }
  ifelse
  /setcmykcolor
  {
     1 sub 4 1 roll
     3 { 3 index add neg dup 0 lt { pop 0} if 3 1 roll } repeat
     fixedsetrgbcolor pop
  } bind def
  /currentcmykcolor
  { currentrgbcolor 3 { 1 sub neg 3 1 roll} repeat 0 } bind def
} ifelse
/colorimage where 
  { pop } 
  { /_put { round cvi _rgb not {255 exch sub} if _str exch _ix exch put
     /_ix _ix 1 add def 0 } bind def
   /_rgbcvt [{.3 mul 1} bind {.59 mul add 2} bind {.11 mul add _put} bind] def
   /_cmykcvt
    [ {1} bind {add 2} bind {add 3} bind
      {/gl exch def 3 div 255 gl sub 255 div mul gl add _put} bind ] def
   /_monoproc { _colorproc
      /_str 1 index dup length _rgb {3} {4} ifelse idiv 0 exch getinterval def
      /_ix 0 def 0 exch { exch _rgb {_rgbcvt} {_cmykcvt} ifelse exch get exec} forall
      pop _str } bind def
   /colorimage { 3 eq /_rgb exch def pop /_colorproc exch def /_monoproc load image
    } bind def 
  } ifelse
/set-overprint {
    systemdict /setoverprint known {
        1 eq {true setoverprint} {false setoverprint} ifelse
    } {
        pop
    } ifelse
} def

userdict begin

/ndef {
    1 index where {
        pop pop pop
    }{
        dup xcheck {bind} if def
    } ifelse
} bind def
/findcmykcustomcolor {
    5 /packedarray where {
        pop packedarray
    } {
        array astore readonly
    } ifelse
} ndef

%% need to know level for color separation and gradient fill use
%% but if in Preps separation environment, force Level 1 behavior
/xIsLevel2? systemdict /setcolor known def  % if known, not Level 1
/PrepsDict where {
    pop /PrepsSepDict where {
        pop PrepsSepDict /ColorTable known not {
            /xIsLevel2? false def
        } if
    } if
} if
/setcustomcolor  %% lay down name; we'll define in various ways
            %% stack in:  [C M Y K (Name)] Tint
            %% stack out: -
{
    color-separation 0 eq {  %% this is composite form
        xIsLevel2? {  %% this is level 2 or greater
            exch
            [   exch /Separation exch dup 4 get
                exch /DeviceCMYK
                exch 0 4 getinterval
                [   exch
                    /dup load exch cvx {mul exch dup}
                    /forall load
                    /pop load dup
                ] cvx
            ] setcolorspace
            setcolor
        }{  %% this is Level 1 -- stick to the old code
            exch aload pop pop
            4 { 4 index mul 4 1 roll} repeat
            xyspotcolor
        } ifelse
    }{ %% XPP preseparated - Level 1 code works fine
        exch aload pop 6 -1 roll 1.0 exch sub
        exch dup xyspotdict exch known {
            pop pop setcmykcolor
        }{
            xyspotcolor
        } ifelse
    } ifelse
%% finally define /setcustomcolor
} ndef
/setseparationgray
{
    xIsLevel2? {
        /setseparationgray {
            [/Separation /All /DeviceCMYK {dup dup dup}] setcolorspace
            1 exch sub setcolor } bind def
    }{
        /setseparationgray {
            1 exch sub dup dup dup setcmykcolor } bind def
    } ifelse
} ndef
systemdict /setoverprint known not {
    /setoverprint {pop} def
} if

end  %% end userdict

/xyspotcolor {
    setcmykcolor pop
} def
/xyallcolor {
        pop pop systemdict begin setcmykcolor end
} def
/cyan_overprint_on { } def
/cyan_overprint_off { } def
/magenta_overprint_on { } def
/magenta_overprint_off { } def
/yellow_overprint_on { } def
/yellow_overprint_off { } def
/black_overprint_on { } def
/black_overprint_off { } def
/S {show} bind def
/A {ashow} bind def
/ST {stroke 0 0 moveto} bind def

/xytrdict 1 dict def
xytrdict begin
/lasttr () def
end
/xyduplex {
  exch dup
  xytrdict /lasttr get eq {
    pop pop
  } {
    xytrdict /lasttr 3 -1 roll put exec
  } ifelse
} def
/pdfmark where
{pop} {userdict /pdfmark /cleartomark load put} ifelse
%%EndProlog

%%BeginSetup
[  /PageMode /UseOutlines  /Action /GoTo  /Page 1 /View [ /XYZ 0 800 1.0 ] /DOCVIEW pdfmark
%%EndSetup

%Driver Version 3.0 2
%%Page: 1 1
%%PageFonts: (atend)
%%BeginPageSetup

statusdict /825x1075tray known {statusdict begin 825x1075tray end} if
/saveobj save def
/#copies 1 def 0 0 0 1 setcmykcolor
/color-separation 0 def
72 25400 div dup SC 0 rotate 55 273101 T newpath 
 0 0 M /savectm matrix currentmatrix def 

[ /CropBox [ 0.0 0.0 594.000000 774.000000 ] /PAGE pdfmark
[ {ThisPage} << /TrimBox [ 0.0 0.0 594.000000 774.000000 ] >> /PUT pdfmark
%%EndPageSetup
%%PageBoundingBox: 0 0 595 775 
%%PageHiResBoundingBox: 0.0 0.0 594.000000 774.000000 
%%PageCropBox: 0.0 0.0 594.000000 774.000000 
3465 -7091 translate
-3465 7091 translate

savectm setmatrix gsave newpath
0 rotate -6336 0 T 0 -38016 M  1 set-overprint
0 0 0 1 userdict begin setcmykcolor end

%The following is in preparation for an EPS graphic
/EPS_state save def
%Delete definepattern that can croak an Adobe Illustrator EPS
/definepattern where { /definepattern undef } if
/xy_dict_count countdictstack def
count /operand_count exch def
userdict begin
/showpage {} def
0 setlinecap
1 setlinewidth 0 setlinejoin
10 setmiterlimit [] 0 setdash newpath
/languagelevel where
{pop languagelevel
1 ne
	{false setstrokeadjust false setoverprint
	} if
} if

