%
%%BeginProcSet: rect
% expects outline size, outline type, patternname, width, depth
/rectdict 24 dict def
rectdict begin
/nP{newpath}def /gS{gsave}def /gR{grestore}def
/xD{exch def}def
end
/rect
{rectdict begin
currentpoint
/sy xD /sx xD /d xD /w xD /ptn xD /ot xD /os xD /sb xD /dl xD
w 0 ne d 0 ne and
{os 0 eq
{/ot 0 def}if
ot 0 ne
{ot 3 mod 2 eq
{/d d os sub def /w w os sub def
/sx sx os 2 div add def /sy sy os 2 div sub def}
{ot 3 mod 0 eq
{/d d os add def /w w os add def
/sx sx os 2 div sub def /sy sy os 2 div add def}if
}ifelse
}if
dl 65535 eq dl 0 le or
{/dl os def}if
sb 65535 eq sb 0 le or
{/sb dl def}if
/rectpath
{nP sx sy M 0 0 d sub RL w 0 RL 0 d RL closepath}def
/centerdash
{/patternlength dl sb add def pathlen sb gt
{/part pathlen sb sub round cvi patternlength round cvi mod def
/incr part 2 div def [sb dl ] 0 setdash
/pathlen pathlen part sub def}
{/incr 0 def}ifelse
}def
/wideouter
{/sx sx os 8 div add def /sy sy os 8 div sub def
/w w os 4 div sub def /d d os 4 div sub def
rectpath os 4 div LW
}def
/wideinner
{/sx sx os 8 div sub def /sy sy os 8 div add def
/w w os 4 div add def /d d os 4 div add def
rectpath os 4 div LW
}def
/dashsides
{nP /pathlen d os sub def centerdash
sx sy os 2 div sub incr sub M 0 0 pathlen sub RL ST
nP /pathlen w os sub def centerdash
sx incr add os 2 div add sy M pathlen 0 RL ST
nP /pathlen w os sub def centerdash
sx incr add os 2 div add sy d sub M pathlen 0 RL ST
nP /pathlen d os sub def centerdash
sx w add sy os 2 div sub incr sub M 0 0 pathlen sub RL ST
}def
/rectoutline
{ot 1 ge ot 3 le and ot 15 gt or
{whichcolor 2 ne {gS os LW olineco ST gR}if}
{ot 4 ge ot 12 le and
{whichcolor 2 ne {gS olineco os LW ST gR}if
ot 4 ge ot 6 le and
{whichcolor 1 ne {gS altco os 5 div LW ST gR}if}
{ot 7 ge ot 9 le and
{whichcolor 1 ne {gS altco wideouter ST gR}if}
{whichcolor 1 ne {gS altco wideinner ST gR}if
}ifelse
}ifelse
}
{ot 13 ge ot 15 le and
{whichcolor 2 ne {gS olineco os LW ST gR}if
whichcolor 1 ne {gS altco os LW dashsides gR}if
}if
}ifelse
}ifelse
}def
rectpath tpfill rectoutline
}if
end
}bind def
%%EndProcSet: rect
%
%%BeginProcSet: rounded
%a rectangle with rounded corners
%expects outline size, outline type, patternname,
%width, depth, radius of corners
/rrdict 54 dict def
rrdict begin
/nP{newpath}def /gS{gsave}def /gR{grestore}def /xD{exch def}def
end
/round_rect
{rrdict begin
/rad xD /d xD /w xD currentpoint
/sy xD /sx xD /ptn xD /ot xD /os xD /sb xD /dl xD
os 0 eq
{/ot 0 def}if
ot 0 ne
{ot 3 mod 2 eq
{d os gt {/d d os sub def}if
w os gt {/w w os sub def}if
/sx sx os 2 div add def /sy sy os 2 div sub def
}
{ot 3 mod 0 eq
{/d d os add def /w w os add def
/sx sx os 2 div sub def /sy sy os 2 div add def
}if
}ifelse
}if
dl 65535 eq dl 0 le or
{/dl os def}if
sb 65535 eq dl 0 le or
{/sb dl def}if
w d lt
{rad w 2 div gt {/rad w 2 div def}if}
{rad d 2 div gt {/rad d 2 div def}if
}ifelse
/roundpath
{nP sx w 2 div add sy M 
sx w add sy sx w add sy d 2 div sub rad arcto
sx w add sy d sub sx w 2 div add sy d sub rad arcto
sx sy d sub sx sy d 2 div add rad arcto
sx sy sx w 2 div add sy rad arcto
pop pop 3 -1 roll sub 2 mul /sidea xD
pop pop pop 3 1 roll pop exch sub 2 mul /sideb xD
6 {pop} repeat closepath
/pathlen sidea sideb add rad 6.283185307 mul add def
}def
/centerdash
{/ptnlen dl sb add def pathlen sb gt
{/part pathlen sb sub round cvi ptnlen round cvi mod def
/incr part 2 div def [sb dl ] 0 setdash /pathlen pathlen part sub def
}{/incr 0 def
}ifelse
}def
/wideouter
{/sx sx os 8 div add def /sy sy os 8 div sub def
/rad rad os 8 div sub def /w w os 4 div sub def
/d d os 4 div sub def roundpath os 4 div LW
}def
/wideinner
{/sx sx os 8 div sub def /sy sy os 8 div add def
/rad rad os 8 div add def /w w os 4 div add def
/d d os 4 div add def roundpath os 4 div LW
}def
/dashsides
{/corner rad os gt {rad} {os} ifelse def
nP /pathlen d corner sub def centerdash
sx sy corner 2 div sub incr sub M 0 0 pathlen sub RL ST
nP /pathlen w corner sub def centerdash
sx incr add corner 2 div add sy M pathlen 0 RL ST
nP /pathlen w corner sub def centerdash
sx incr add corner 2 div add sy d sub M pathlen 0 RL ST
nP /pathlen d corner sub def centerdash
sx w add sy corner 2 div sub incr sub M 0 0 pathlen sub RL ST
}def
/rndoutline
{ot 0 ne  %if not none
{ot 1 ge ot 3 le and ot 15 gt or  %single
{whichcolor 2 ne
{gS os LW olineco ST gR}if
}
{ot 4 ge ot 12 le and  %double with white stripe
{whichcolor 2 ne
{gS olineco os LW ST gR}if 
ot 4 ge ot 6 le and  %double
{whichcolor 1 ne
{gS altco os 5 div LW ST gR}if
}
{ot 7 ge ot 9 le and  %outer twice as wide as inner
{whichcolor 1 ne
{gS altco wideouter ST gR}if
}
{% inner twice as wide as outer
whichcolor 1 ne
{gS altco wideinner ST gR}if
}ifelse
}ifelse
}
{ot 13 ge ot 15 le and  % dashes
{whichcolor 2 ne
{gS olineco os LW ST gR}if
whichcolor 1 ne
{gS altco os LW dashsides gR}if
}if
}ifelse
}ifelse
}if
}def
roundpath tpfill rndoutline
end
}bind def
%%EndProcSet: rounded
%
%%BeginProcSet: ellipse
%expects outline size, outline type, patternname, x-radius, y-radius
/elpdict 53 dict def
elpdict begin
/gS{gsave}def /gR{grestore}def /xD{exch def}def
/mtrx matrix def
end
/ellipse
{elpdict begin
/yrad xD /xrad xD currentpoint
/y xD /x xD /ptn xD
/savematrix mtrx currentmatrix def
/ot xD /os xD /sb xD /dl xD
os 0 eq {/ot 0 def}if
ot 0 ne
{ot 3 mod 2 eq
{/xrad xrad os 2 div sub def /yrad yrad os 2 div sub def
/x x os 2 div add def /y y os 2 div sub def}
{ot 3 mod 0 eq
{/xrad xrad os 2 div add def /yrad yrad os 2 div add def
/x x os 2 div sub def /y y os 2 div add def}if
}ifelse
}if
dl 65535 eq dl 0 le or {/dl os def}if
sb 65535 eq sb 0 le or {/sb dl def}if
/ellpath 
{newpath x xrad add y yrad sub T xrad yrad SC
0 0 1 0 360 arc closepath savematrix setmatrix}def
/wideouter
{/x x os 8 div add def /y y os 8 div sub def
/xrad xrad os 8 div sub def /yrad yrad os 8 div sub def
ellpath os 4 div LW}def
/wideinner
{/x x os 8 div sub def /y y os 8 div add def
/xrad xrad os 8 div add def /yrad yrad os 8 div add def
ellpath os 4 div LW}def
/pathlen
{flattenpath /dist 0 def
{/yfirst xD /xfirst xD /ymoveto yfirst def 
/xmoveto xfirst def}
{/ynext xD /xnext xD
/dist dist ynext yfirst sub dup mul
xnext xfirst sub dup mul add sqrt add def
/yfirst ynext def /xfirst xnext def}
{}
{/ynext ymoveto def /xnext xmoveto def 
/dist dist ynext yfirst sub dup mul
xnext xfirst sub dup mul add sqrt add def
/yfirst ynext def /xfirst xnext def}
pathforall dist
}def
/centerdash
{/pattlen dl sb add def
/whole pathlen round cvi pattlen round cvi idiv def
/part pathlen round cvi pattlen round cvi mod def
/incr  part whole div def
[dl sb incr add ] dl 2 div setdash
}def
/eloutline 
{ot 0 ne
{ot 1 ge ot 3 le and ot 15 gt or
{whichcolor 2 ne {gS olineco os LW ST gR}if}
{ot 4 ge ot 12 le and
{whichcolor 2 ne {gS olineco os LW ST gR}if
whichcolor 1 ne
{ot 4 ge ot 6 le and
{gS altco os 5 div LW ST gR}
{ot 7 ge ot 9 le and %outer twice as wide as inner
{gS altco wideouter ST gR}
{% inner twice as wide as outer
gS altco wideinner ST gR
}ifelse
}ifelse
}if
}
{ot 13 ge ot 15 le and
{whichcolor 1 ne {gS altco os LW ST gR}if
whichcolor 2 ne
{gS olineco centerdash os LW ST gR}if
}if
}ifelse
}ifelse
}if
}def
ellpath tpfill eloutline
end
}def
