%      /TotalSteps StepsPositive StepsNegative add def
%      /TotalLabels TotalSteps 1 add def
%      /StepHeight ValuesAxisLength TotalSteps div def
%      %/DecimalPlaces ValuesAxisIncrement :places def
%      /DecimalPlaces 2 def
%      /ZeroLineOffset StepsNegative StepHeight mul def
%      % Validate min/max values including label height:
%      /posmargin /S02-SeriesValuesLabels-MarginBottom /d specdictvalue def
%      /negmargin /S07-SeriesValuesLabelsNegative-BottomMarginAlign /d specdictvalue def
%      /totalmargin posmargin negmargin add def
%      StepsPositive 0 gt{
%        /BarMargin
%          /S01-SeriesValuesLabels /capHeight specdictvalue
%          /S02-SeriesValuesLabels-MarginBottom /d specdictvalue
%          add
%        def
%        /ZeroHeight StepsPositive StepHeight mul def
%        /BarMaxHeight ZeroHeight BarMargin sub def
