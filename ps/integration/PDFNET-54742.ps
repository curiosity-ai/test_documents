    /superscript-y 3.0
    /colortype (k)
    /color [0]    % 0.15 = 85%
    /overprint true
    /capHeight 5.6
    /centerCorrect 0.0258  % due to stringwidth unable to account for tracking (ashow)
  >> def

  /S02-SeriesValuesLabels-MarginBottom <<
    /d 5.5
  >> def

  /S04-Bars <<
    % For solid bars tint = tintMax
    /w 22 %BarWidth
    /colortype (k)
    % 2945    (changed by XML parameter. See /Color[] in PostScript output)
    /color [0]    % 0.25 = 75%
    /tint 1        % 0.7 = 70%
    /tintMax  1
    /topCap   3.0    % Discov #3
  >> def

  /S05-HorizontalRule <<
    /l 458.5
    /w 1
    /colortype (k)
    /color [0]    % 0.15 = 85%
    /tint 1
    /tintMax 1
    /overprint true				    
  >> def

  /S05-HorizontalRuleDebug <<
    /debug false
    /l 286.5
    /w 0.5
    /colortype (rgb)
    /color [255 0 0]    % red
    /overprint true
  >> def

  /S05-ValuesAxis-MarginLeft <<
    /d 30.1
  >> def

  /S06-SeriesAxisLabels << % Date labels
    /f /OpenSans
    /s 9.0
    /colortype (k)
    /color [0]    % 0.15 = 85%
    /overprint true
    /capHeight 5.0    
    /superscriptsize 5.0
    /superscript-y 3.0
    /fontindex 0
  >> def

  /S04-SeriesAxisLabels-BottomMarginAlign <<
    /d 17.6
	  /ybuffer 2.3
  >> def

  /S07-ValuesAxis <<
    /l 101.3
    /w 1
    /origin 19.9  %17.6 + 2.3 (bottom space)
    /colortype (k)
    /color [0]    % 0.15 = 85%
  >> def

  /S08-BoundingBox <<
    /BoxWidth 489
    /BoxHeight 129
    /colortype (K)
    /color [0]
    /tint 1
    /separation (PANTONE 324 C)
    /tinttransform [0.28 0 0.12 0]
    /x 0
    /y 0
    /w 367
    /h 367
    /filled false
  >> def

  /S10-ValuesAxis-MarginTop <<
    /d 7.8
  >> def

  /S13-Bars-Spacing <<
    /d 14.178
  >> def

  /S07-SeriesValuesLabelsNegative-BottomMarginAlign <<
    /d 11.0
  >> def

  /S01-ValuesAxisLabels <<
	/f /OpenSans
	/fontindex 0
	/s 9.0
	/superscriptsize 5.0
	/superscript-y 3.0
	/colortype (k)
	/color [0]    % 0.15 = 85%
	/overprint true
    /capheight 5.22
 >> def

 /S02-ValuesAxisLabels-RightMarginAlign <<
   /d 27.6
 >> def

  %/S03-Title <<
  %  /f /Arial-BoldMT
  %  /fontindex 0
  %  /s 9.0
  %  /superscriptsize 3.8
  %  /superscript-y 2.5
  %  /colortype (k)
  %  /color [0]    % 0.15 = 85%
  %  /overprint true
  %  /capheight 5.22
  %  /align 6.8     % #4 - baseline to bounding box
  %>> def

  % For gadient
  %/S04-Bars <<
  %  % *** means fixed for template
  %  /colortype (k) %               ***
  %  /color [0.10]  % start at 10%  (reset to 0.10 for each use) ***
  %  /tint 0.10     %               ***
  %  /tintMax 0.85  % end at 85%    ***
  %  /w 16.0        %               ***
  %  /l -10         % height of bar
  %  /originX 30     % center of bar
  %  /originY 700    % y = 0 position***
  %>> def
  
  %/S08-Bar-Outline <<
  %  /w 0.5
